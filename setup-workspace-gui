    def _toggle_technical_columns(self, show: bool) -> None:
        self.table.setColumnHidden(3, not show)
        self.table.setColumnHidden(4, not show)
        self.table.horizontalHeader().setSectionResizeMode(1, QHeaderView.ResizeMode.ResizeToContents)
        self.table.horizontalHeader().setSectionResizeMode(2, QHeaderView.ResizeMode.Stretch)

    def _rebuild_tabs(self) -> None:
        current_filter = self._current_filter()
        self.tab_bar.blockSignals(True)
        while self.tab_bar.count() > 0:
            self.tab_bar.removeTab(0)

        desktop_nums = sorted({e.desktop for e in self.entries if e.desktop > 0})
        for d in (1, 2, 3):
            if d not in desktop_nums:
                desktop_nums.append(d)
        desktop_nums = sorted(desktop_nums)

        self.tab_filters = [None]
        self.tab_bar.addTab(f"All ({len(self.entries)})")

        for d in desktop_nums:
            cnt = sum(1 for e in self.entries if e.desktop == d)
            self.tab_filters.append(d)
            self.tab_bar.addTab(f"Desktop {d} ({cnt})")

        if any(e.desktop == 0 for e in self.entries):
            cnt = sum(1 for e in self.entries if e.desktop == 0)
            self.tab_filters.append(0)
            self.tab_bar.addTab(f"Stop Only ({cnt})")

        idx = self.tab_filters.index(current_filter) if current_filter in self.tab_filters else 0
        self.tab_bar.setCurrentIndex(idx)
        self.tab_bar.blockSignals(False)

    def _current_filter(self) -> int | None:
        idx = self.tab_bar.currentIndex()
        if 0 <= idx < len(self.tab_filters):
            return self.tab_filters[idx]
        return None

    def _reload(self) -> None:
        self.entries = parse_config()
        self._rebuild_tabs()
        self._populate_table()
        self._update_desktop_status()
        self._update_install_button()

    def _populate_table(self) -> None:
        filt = self._current_filter()
        self.table.setRowCount(0)
        for real_idx, entry in enumerate(self.entries):
            if filt is not None and entry.desktop != filt:
                continue
            r = self.table.rowCount()
            self.table.insertRow(r)
            desk_str = "Stop Only" if entry.desktop == 0 else f"Desktop {entry.desktop}"
            desk_item = QTableWidgetItem(desk_str)
            desk_item.setData(Qt.ItemDataRole.UserRole, real_idx)

            app_item = QTableWidgetItem(resolve_entry_icon(entry, self.app_icons), entry.name)
            if entry.cmd:
                app_item.setToolTip(f"Command: {entry.cmd}")

            beh_item = QTableWidgetItem(entry.behavior_summary())
            cmd_item = QTableWidgetItem(entry.cmd or "-")
            cls_item = QTableWidgetItem(entry.classes or "-")

            for c, item in enumerate((desk_item, app_item, beh_item, cmd_item, cls_item)):
                self.table.setItem(r, c, item)

        self.table.resizeColumnToContents(0)
        self.table.resizeColumnToContents(1)
        is_all = filt is None
        self.up_btn.setEnabled(is_all)
        self.down_btn.setEnabled(is_all)

    def _selected_real_index(self) -> int | None:
        row = self.table.currentRow()
        if row < 0:
            return None
        item = self.table.item(row, 0)
        if not item:
            return None
        idx = item.data(Qt.ItemDataRole.UserRole)
        return idx if isinstance(idx, int) and 0 <= idx < len(self.entries) else None

    def _update_desktop_status(self) -> None:
        current = query_kwin_desktop_count()
        max_cfg = max((e.desktop for e in self.entries if e.desktop > 0), default=1)
        if current is None:
            self.desktops_lbl.setText("KDE Plasma not detected")
            self.ensure_desk_btn.setVisible(False)
        elif current < max_cfg:
            self.desktops_lbl.setText(f"⚠ {current} Virtual Desktops (need {max_cfg})")
            self.ensure_desk_btn.setVisible(True)
        else:
            self.desktops_lbl.setText(f"✓ {current} Virtual Desktops ready")
            self.ensure_desk_btn.setVisible(False)

    def _update_install_button(self) -> None:
        if LAUNCHER_FILE.exists():
            self.install_btn.setText("✓ In Start Menu (Update)")
        else:
            self.install_btn.setText("Add to Start Menu & Terminal")

    def _persist(self, message: str) -> None:
        save_config(self.entries)
        self._reload()
        self.statusBar().showMessage(f"✓ {message} (Saved to {CONFIG_FILE})", 5000)

    def _save_manual(self) -> None:
        save_config(self.entries)
        self.statusBar().showMessage(f"✓ Configuration saved to {CONFIG_FILE}", 5000)

    def _add_entry(self) -> None:
        filt = self._current_filter()
        default_desk = filt if filt and filt > 0 else 1
        dlg = EntryDialog(default_desktop=default_desk, parent=self, installed_apps=self.installed_apps)
        if dlg.exec() == QDialog.DialogCode.Accepted:
            entry = dlg.build_entry()
            self.entries.append(entry)
            self._persist(f"Added '{entry.name}' to Desktop {entry.desktop}.")

    def _edit_selected(self) -> None:
        real_idx = self._selected_real_index()
        if real_idx is None:
            QMessageBox.information(self, "Edit App", "Please select an application first.")
            return
        cur_row = self.table.currentRow()
        dlg = EntryDialog(self.entries[real_idx], parent=self, installed_apps=self.installed_apps)
        if dlg.exec() == QDialog.DialogCode.Accepted:
            self.entries[real_idx] = dlg.build_entry()
            self._persist(f"Updated '{self.entries[real_idx].name}'.")
            if self.table.rowCount() > 0:
                self.table.selectRow(min(cur_row, self.table.rowCount() - 1))

    def _remove_selected(self) -> None:
        real_idx = self._selected_real_index()
        if real_idx is None:
            QMessageBox.information(self, "Remove App", "Please select an application first.")
            return
        cur_row = self.table.currentRow()
        name = self.entries[real_idx].name
        ans = QMessageBox.question(self, "Remove App", f"Remove '{name}' from your workspace?")
        if ans == QMessageBox.StandardButton.Yes:
            del self.entries[real_idx]
            self._persist(f"Removed '{name}'.")
            if self.table.rowCount() > 0:
                self.table.selectRow(min(cur_row, self.table.rowCount() - 1))

    def _move_selected(self, delta: int) -> None:
        if self._current_filter() is not None:
            return
        row = self.table.currentRow()
        new_row = row + delta
        if row < 0 or new_row < 0 or new_row >= len(self.entries):
            return
        self.entries[row], self.entries[new_row] = self.entries[new_row], self.entries[row]
        self._persist("Updated launch order.")
        self.table.selectRow(new_row)

    def _show_context_menu(self, pos) -> None:
        real_idx = self._selected_real_index()
        if real_idx is None:
            return
        menu = QMenu(self)
        menu.addAction(QIcon.fromTheme("document-edit"), "Edit...", self._edit_selected)
        move_menu = menu.addMenu("Move to Desktop")
        for d in (1, 2, 3, 4):
            act = QAction(f"Desktop {d}", self)
            act.triggered.connect(lambda _=False, desk=d, idx=real_idx: self._move_to_desktop(idx, desk))
            move_menu.addAction(act)
        menu.addSeparator()
        menu.addAction(QIcon.fromTheme("list-remove"), "Remove", self._remove_selected)
        menu.exec(self.table.viewport().mapToGlobal(pos))

    def _move_to_desktop(self, real_idx: int, desk: int) -> None:
        if not (0 <= real_idx < len(self.entries)):
            return
        entry = self.entries[real_idx]
        entry.desktop = desk
        fset = entry.flag_set() - {"close_only"}
        entry.flags = ",".join(sorted(fset))
        self._persist(f"Moved '{entry.name}' to Desktop {desk}.")

    def _apply_preset(self, preset: str) -> None:
        ans = QMessageBox.question(
            self,
            "Reset with Preset",
            f"Replace your current workspace list using the '{preset}' preset?",
        )
        if ans != QMessageBox.StandardButton.Yes:
            return
        res = subprocess.run(
            [str(SETUP_CLI), "reset", "--preset", preset, "--yes"],
            capture_output=True,
            text=True,
            check=False,
        )
        if res.returncode != 0:
            QMessageBox.critical(self, "Error", res.stderr or res.stdout)
            return
        self._reload()
        self.statusBar().showMessage(f"Loaded '{preset}' preset.", 4000)

    def _ensure_desktops(self) -> None:
        res = subprocess.run([str(SETUP_CLI), "ensure-desktops"], capture_output=True, text=True, check=False)
        self._update_desktop_status()
        if res.returncode == 0:
            self.statusBar().showMessage("KDE Virtual Desktops updated.", 4000)
        else:
            QMessageBox.warning(self, "Virtual Desktops", res.stderr or res.stdout)

    def _toggle_autostart(self, enabled: bool) -> None:
        action = "enable" if enabled else "disable"
        res = subprocess.run([str(SETUP_CLI), "autostart", action], capture_output=True, text=True, check=False)
        if res.returncode == 0:
            self.statusBar().showMessage(f"Login autostart {action}d.", 4000)
        else:
            QMessageBox.warning(self, "Autostart", res.stderr or res.stdout)

    def _install_cli(self) -> None:
        res = subprocess.run([str(SETUP_CLI), "install"], capture_output=True, text=True, check=False)
        self._update_install_button()
        if res.returncode == 0:
            QMessageBox.information(
                self,
                "Added to Start Menu & Terminal",
                "Workspace Setup is now in your KDE Application Launcher, and terminal commands are linked in ~/.local/bin.",
            )
        else:
            QMessageBox.warning(self, "Install Error", (res.stdout + "\n" + res.stderr).strip())

    def _uninstall_cli(self) -> None:
        res = subprocess.run([str(SETUP_CLI), "uninstall"], capture_output=True, text=True, check=False)
        self._update_install_button()
        if res.returncode == 0:
            self.statusBar().showMessage("Removed Start Menu & terminal shortcuts.", 4000)
        else:
            QMessageBox.warning(self, "Uninstall Error", (res.stdout + "\n" + res.stderr).strip())

    def _run_doctor(self) -> None:
        env = os.environ.copy()
        env["NO_COLOR"] = "1"
        res = subprocess.run([str(SETUP_CLI), "doctor"], capture_output=True, text=True, env=env, check=False)
        clean = re.sub(r"\x1b\[[0-9;]*m", "", res.stdout + res.stderr)
        CommandOutputDialog("System Health Check", clean, self).exec()

    def _inspect_windows(self) -> None:
        OpenWindowPickerDialog(self).exec()

    def _open_config_folder(self) -> None:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        QDesktopServices.openUrl(QUrl.fromLocalFile(str(CONFIG_DIR)))

    def _run_async(self, cmd: list[str], label: str) -> None:
        if self.proc and self.proc.state() != QProcess.ProcessState.NotRunning:
            QMessageBox.information(self, "Busy", "Another workspace command is still running.")
            return
        self.statusBar().showMessage(f"{label}...")
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.proc.finished.connect(lambda code, _status: self._on_proc_finished(label, code))
        self.proc.start(cmd[0], cmd[1:])

    def _on_proc_finished(self, label: str, code: int) -> None:
        output = bytes(self.proc.readAll()).decode("utf-8", errors="ignore") if self.proc else ""
        if code == 0:
            self.statusBar().showMessage(f"{label}: done.", 4000)
        else:
            CommandOutputDialog(f"{label} (exit {code})", output or "(no output captured)", self).exec()


def main() -> int:
    app = QApplication(sys.argv)
    app.setApplicationName("Workspace Setup")
    app.setDesktopFileName("start-workspace-setup")
    win = MainWindow()
    win.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
