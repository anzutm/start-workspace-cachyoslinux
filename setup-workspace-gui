        self.setMinimumWidth(520)
        self.installed_apps = installed_apps

        layout = QVBoxLayout(self)
        layout.setSpacing(12)

        # Quick Pick section (front and center for beginners)
        pick_box = QGroupBox("1. Choose Application")
        pick_layout = QVBoxLayout(pick_box)
        pick_hint = QLabel("Pick an installed app and we'll fill in the technical settings for you:")
        pick_hint.setWordWrap(True)
        pick_layout.addWidget(pick_hint)

        quick_row = QHBoxLayout()
        pick_app_btn = QPushButton(QIcon.fromTheme("applications-other"), "Choose Installed App...")
        pick_app_btn.clicked.connect(self._pick_installed_app)
        browse_btn = QPushButton(QIcon.fromTheme("document-open"), "Choose Custom File / Script...")
        browse_btn.clicked.connect(self._browse_cmd)
        quick_row.addWidget(pick_app_btn)
        quick_row.addWidget(browse_btn)
        pick_layout.addLayout(quick_row)
        layout.addWidget(pick_box)

        # Simple Settings
        basic_box = QGroupBox("2. Placement & Behavior")
        form = QFormLayout(basic_box)

        self.name_edit = QLineEdit(entry.name if entry else "")
        self.name_edit.setPlaceholderText("e.g. Firefox, VS Code, Terminal")
        form.addRow("App Name:", self.name_edit)

        self.desktop_spin = QSpinBox()
        self.desktop_spin.setRange(1, 20)
        self.desktop_spin.setPrefix("Desktop ")
        self.desktop_spin.setValue(entry.desktop if entry and entry.desktop > 0 else max(1, default_desktop))
        form.addRow("Open on:", self.desktop_spin)

        self.keep_open_cb = QCheckBox("Keep this app open when clicking Stop Workspace (recommended for terminal)")
        form.addRow("", self.keep_open_cb)
        layout.addWidget(basic_box)

        # Collapsible Advanced Settings (hidden by default for beginners)
        self.adv_toggle = QPushButton("▸ Advanced Settings (Command, Window Matching, Special Flags)")
        self.adv_toggle.setFlat(True)
        self.adv_toggle.setCheckable(True)
        self.adv_toggle.setStyleSheet("text-align: left; font-weight: bold; padding: 4px 0;")
        self.adv_toggle.toggled.connect(self._toggle_advanced)
        layout.addWidget(self.adv_toggle)

        self.adv_widget = QWidget()
        adv_layout = QVBoxLayout(self.adv_widget)
        adv_layout.setContentsMargins(0, 0, 0, 0)

        adv_form = QFormLayout()
        self.cmd_edit = QLineEdit(entry.cmd if entry else "")
        self.cmd_edit.setPlaceholderText('e.g. firefox or code "/path/to/project"')
        adv_form.addRow("Launch Command:", self.cmd_edit)

        self.pattern_edit = QLineEdit(entry.pattern if entry else "")
        self.pattern_edit.setPlaceholderText("Auto-filled from command if blank")
        adv_form.addRow("Process Pattern:", self.pattern_edit)

        cls_row = QHBoxLayout()
        self.classes_edit = QLineEdit(entry.classes if entry else "")
        self.classes_edit.setPlaceholderText("Auto-filled if blank")
        pick_win_btn = QPushButton(QIcon.fromTheme("window-duplicate"), "Detect Open Window...")
        pick_win_btn.clicked.connect(self._pick_open_window)
        cls_row.addWidget(self.classes_edit)
        cls_row.addWidget(pick_win_btn)
        adv_form.addRow("Window Classes:", cls_row)
        adv_layout.addLayout(adv_form)

        self.close_only_cb = QCheckBox("Close-only rule (do not launch on Start, only close on Stop)")
        self.close_only_cb.toggled.connect(self._on_close_only_toggled)
        self.flatpak_cb = QCheckBox("Flatpak app (also run 'flatpak kill' when stopping)")
        self.check_cmd_cb = QCheckBox("Skip launching if command/file does not exist (check_cmd)")
        self.check_arg1_cb = QCheckBox("Skip launching if target file argument does not exist (check_arg1)")
        for cb in (self.close_only_cb, self.flatpak_cb, self.check_cmd_cb, self.check_arg1_cb):
            adv_layout.addWidget(cb)

        self.adv_widget.setVisible(False)
        layout.addWidget(self.adv_widget)

        if entry:
            fset = entry.flag_set()
            self.keep_open_cb.setChecked("keep_open" in fset)
            self.flatpak_cb.setChecked("flatpak" in fset)
            self.check_cmd_cb.setChecked("check_cmd" in fset)
            self.check_arg1_cb.setChecked("check_arg1" in fset)
            if "close_only" in fset or entry.desktop == 0:
                self.close_only_cb.setChecked(True)

        btn_row = QHBoxLayout()
        btn_row.addStretch()
        cancel_btn = QPushButton("Cancel")
        cancel_btn.clicked.connect(self.reject)
        save_btn = QPushButton(QIcon.fromTheme("document-save"), "Save App")
        save_btn.setDefault(True)
        save_btn.clicked.connect(self._validate_and_accept)
        btn_row.addWidget(cancel_btn)
        btn_row.addWidget(save_btn)
        layout.addLayout(btn_row)

    def _toggle_advanced(self, checked: bool) -> None:
        self.adv_widget.setVisible(checked)
        self.adv_toggle.setText(
            ("▾ " if checked else "▸ ") + "Advanced Settings (Command, Window Matching, Special Flags)"
        )
        self.adjustSize()

    def _on_close_only_toggled(self, checked: bool) -> None:
        self.desktop_spin.setEnabled(not checked)
        self.cmd_edit.setEnabled(not checked)

    def _browse_cmd(self) -> None:
        path, _ = QFileDialog.getOpenFileName(self, "Select Executable or Script", str(Path.home()))
        if path:
            quoted = f'"{path}"' if " " in path else path
            self.cmd_edit.setText(quoted)
            if not self.name_edit.text().strip():
                self.name_edit.setText(Path(path).stem)
            if not self.pattern_edit.text().strip():
                self.pattern_edit.setText(Path(path).name)
            if not self.classes_edit.text().strip():
                self.classes_edit.setText(Path(path).name)

    def _pick_installed_app(self) -> None:
        dlg = AppPickerDialog(self, apps=self.installed_apps)
        if dlg.exec() == QDialog.DialogCode.Accepted and dlg.selected_app:
            app = dlg.selected_app
            self.name_edit.setText(app["name"])
            self.cmd_edit.setText(app["exec"])
            self.pattern_edit.setText(app["pattern"])
            self.classes_edit.setText(app["classes"])
            self.flatpak_cb.setChecked(bool(app["is_flatpak"]))

    def _pick_open_window(self) -> None:
        dlg = OpenWindowPickerDialog(self)
        if dlg.exec() == QDialog.DialogCode.Accepted and dlg.selected_row:
            desks, cls, name, caption = dlg.selected_row
            classes = [c for c in [cls, name] if c]
            self.classes_edit.setText(",".join(dict.fromkeys(classes)))
            first_desk = desks.split(",")[0].strip()
            if first_desk.isdigit() and int(first_desk) >= 1 and not self.close_only_cb.isChecked():
                self.desktop_spin.setValue(int(first_desk))
            if not self.pattern_edit.text().strip() and cls:
                self.pattern_edit.setText(cls)
            if not self.name_edit.text().strip():
                self.name_edit.setText(caption.split(" - ")[-1][:30] if caption else cls)

    def _validate_and_accept(self) -> None:
        name = self.name_edit.text().strip()
        cmd = self.cmd_edit.text().strip()
        pattern = self.pattern_edit.text().strip()
        classes = self.classes_edit.text().strip()

        if not name:
            QMessageBox.warning(self, "Missing App Name", "Please pick an app or enter an App Name.")
            return
        if not self.close_only_cb.isChecked() and not cmd:
            QMessageBox.warning(
                self,
                "Missing Launch Command",
                "Please use 'Choose Installed App...' or enter a Launch Command under Advanced Settings.",
            )
            return

        if not pattern and cmd:
            try:
                pattern = Path(shlex.split(cmd)[0]).name
            except ValueError:
                pattern = cmd.split()[0]
            self.pattern_edit.setText(pattern)

        if not pattern:
            QMessageBox.warning(self, "Validation", "Process Pattern cannot be empty.")
            return

        if not classes:
            self.classes_edit.setText(pattern)

        for field_name, val in [("Name", name), ("Command", cmd), ("Pattern", pattern), ("Classes", classes)]:
            if "|" in val:
                QMessageBox.warning(self, "Invalid Character", f"{field_name} cannot contain the '|' character.")
                return
        self.accept()

    def build_entry(self) -> WorkspaceEntry:
        flags: list[str] = []
        if self.close_only_cb.isChecked():
            flags.append("close_only")
        if self.keep_open_cb.isChecked():
            flags.append("keep_open")
        if self.flatpak_cb.isChecked() or self.cmd_edit.text().strip().startswith("flatpak run "):
            if "flatpak" not in flags:
                flags.append("flatpak")
        if self.check_cmd_cb.isChecked():
            flags.append("check_cmd")
        if self.check_arg1_cb.isChecked():
            flags.append("check_arg1")

        return WorkspaceEntry(
            desktop=0 if self.close_only_cb.isChecked() else self.desktop_spin.value(),
            name=self.name_edit.text().strip(),
            pattern=self.pattern_edit.text().strip(),
            classes=self.classes_edit.text().strip(),
            flags=",".join(flags),
            cmd="" if self.close_only_cb.isChecked() else self.cmd_edit.text().strip(),
        )


class CommandOutputDialog(QDialog):
    """Modal dialog to display CLI output cleanly."""

    def __init__(self, title: str, text: str, parent: QWidget | None = None) -> None:
        super().__init__(parent)
        self.setWindowTitle(title)
        self.resize(660, 420)
        layout = QVBoxLayout(self)
        box = QPlainTextEdit()
        box.setReadOnly(True)
        box.setPlainText(text)
        layout.addWidget(box)
        buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Close)
        buttons.rejected.connect(self.reject)
        buttons.accepted.connect(self.accept)
        layout.addWidget(buttons)


