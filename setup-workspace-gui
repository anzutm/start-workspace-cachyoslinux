CONFIG_HEADER = """# Workspace Manager Configuration
# Format: DESKTOP|NAME|PROC_PATTERN|WINDOW_CLASSES|FLAGS|COMMAND
#   DESKTOP        : 1-based Virtual Desktop number (0 = close-only for stop-workspace)
#   NAME           : Human-readable application name
#   PROC_PATTERN   : Pattern used by pgrep -f / pkill -f
#   WINDOW_CLASSES : Comma-separated KWin resourceClass / resourceName values
#   FLAGS          : Comma-separated flags: keep_open, flatpak, check_cmd, check_arg1, close_only
#   COMMAND        : Shell command to launch the application
"""

FIELD_CODE_RE = re.compile(r"\s+%[fFuUdDnNickvm]")


@dataclass
class WorkspaceEntry:
    desktop: int
    name: str
    pattern: str
    classes: str
    flags: str
    cmd: str

    def to_line(self) -> str:
        return f"{self.desktop}|{self.name}|{self.pattern}|{self.classes}|{self.flags}|{self.cmd}"

    def flag_set(self) -> set[str]:
        return {f.strip() for f in self.flags.split(",") if f.strip()}

    def behavior_summary(self) -> str:
        fset = self.flag_set()
        if "close_only" in fset or self.desktop == 0:
            return "Closes when stopping workspace"
        parts = ["Opens automatically"]
        if "keep_open" in fset:
            parts.append("Stays open on stop")
        else:
            parts.append("Closes on stop")
        if "flatpak" in fset:
            parts.append("Flatpak")
        return " • ".join(parts)


def parse_config() -> list[WorkspaceEntry]:
    entries: list[WorkspaceEntry] = []
    if not CONFIG_FILE.exists():
        return entries
    for raw in CONFIG_FILE.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = raw.split("|", 5)
        while len(parts) < 6:
            parts.append("")
        try:
            desktop = int(parts[0].strip())
        except ValueError:
            desktop = 1
        entries.append(
            WorkspaceEntry(
                desktop=desktop,
                name=parts[1].strip(),
                pattern=parts[2].strip(),
                classes=parts[3].strip(),
                flags=parts[4].strip(),
                cmd=parts[5].strip(),
            )
        )
    return entries


def save_config(entries: list[WorkspaceEntry]) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    lines = [CONFIG_HEADER.rstrip(), ""]
    for entry in entries:
        lines.append(entry.to_line())
    CONFIG_FILE.write_text("\n".join(lines) + "\n", encoding="utf-8")


def query_kwin_desktop_count() -> int | None:
    if not shutil.which("qdbus6"):
        return None
    res = subprocess.run(
        ["qdbus6", "org.kde.KWin", "/VirtualDesktopManager", "count"],
        capture_output=True,
        text=True,
        check=False,
    )
    val = res.stdout.strip()
    return int(val) if val.isdigit() else None


def list_open_kwin_windows() -> list[tuple[str, str, str, str]]:
    """Return [(desktops, resourceClass, resourceName, caption), ...] via KWin Scripting + Gio."""
    if not shutil.which("qdbus6"):
        return []
    try:
        import gi

        gi.require_version("Gio", "2.0")
        from gi.repository import Gio, GLib
    except Exception:
        return []

    rows: list[tuple[str, str, str, str]] = []
    xml = """<node><interface name="org.startworkspace.GuiWinProbe">
      <method name="Report">
        <arg type="s" name="cls" direction="in"/>
        <arg type="s" name="name" direction="in"/>
        <arg type="s" name="desktops" direction="in"/>
        <arg type="s" name="caption" direction="in"/>
      </method>
      <method name="Done"/>
    </interface></node>"""

    loop = GLib.MainLoop()
    node = Gio.DBusNodeInfo.new_for_xml(xml)
    tmp_path: str | None = None
    script_name = f"gui_winprobe_{os.getpid()}"

    def on_call(conn, sender, path, iface, method, params, inv):
        if method == "Report":
            cls, name, desks, caption = params.unpack()
            rows.append((desks, cls, name, caption))
            inv.return_value(None)
        elif method == "Done":
            inv.return_value(None)
            loop.quit()

    def on_acquired(conn, name):
        nonlocal tmp_path
        conn.register_object("/Probe", node.interfaces[0], on_call, None, None)
        js = """
var clients = workspace.windowList();
for (var i = 0; i < clients.length; i++) {
    var c = clients[i];
    if (!c.normalWindow) continue;
    var dList = [];
    for (var j = 0; j < c.desktops.length; j++) {
        dList.push(workspace.desktops.indexOf(c.desktops[j]) + 1);
    }
    callDBus("org.startworkspace.GuiWinProbe", "/Probe", "org.startworkspace.GuiWinProbe", "Report",
        String(c.resourceClass || ""), String(c.resourceName || ""),
        dList.length ? dList.join(",") : "all", String(c.caption || ""));
}
callDBus("org.startworkspace.GuiWinProbe", "/Probe", "org.startworkspace.GuiWinProbe", "Done");
"""
        with tempfile.NamedTemporaryFile("w", suffix=".js", delete=False) as f:
            f.write(js)
            tmp_path = f.name
        subprocess.run(
            ["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.loadScript", tmp_path, script_name],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        subprocess.run(
            ["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.start"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        GLib.timeout_add(1500, loop.quit)

    owner_id = Gio.bus_own_name(
        Gio.BusType.SESSION,
        "org.startworkspace.GuiWinProbe",
        Gio.BusNameOwnerFlags.NONE,
        on_acquired,
        None,
        None,
    )
    try:
        loop.run()
    finally:
        Gio.bus_unown_name(owner_id)
        subprocess.run(
            ["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.unloadScript", script_name],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if tmp_path and os.path.exists(tmp_path):
            os.unlink(tmp_path)
    return rows


def scan_desktop_apps() -> list[dict[str, str]]:
    """Scan installed .desktop files for quick app selection."""
    dirs = [
        "/usr/share/applications",
        str(Path.home() / ".local/share/applications"),
        "/var/lib/flatpak/exports/share/applications",
        str(Path.home() / ".local/share/flatpak/exports/share/applications"),
    ]
    apps: dict[str, dict[str, str]] = {}
    for d in dirs:
        if not os.path.isdir(d):
            continue
        for path in glob.glob(os.path.join(d, "*.desktop")):
            try:
                text = Path(path).read_text(encoding="utf-8", errors="ignore")
            except OSError:
                continue
            in_entry = False
            data: dict[str, str] = {}
            for line in text.splitlines():
                stripped = line.strip()
                if stripped.startswith("["):
                    in_entry = stripped == "[Desktop Entry]"
                    continue
                if not in_entry or "=" not in stripped or stripped.startswith("#"):
                    continue
                k, v = stripped.split("=", 1)
                data.setdefault(k.strip(), v.strip())

            if data.get("Type") != "Application":
                continue
            if data.get("NoDisplay", "").lower() == "true" or data.get("Hidden", "").lower() == "true":
                continue
            name = data.get("Name", "")
            exec_raw = data.get("Exec", "")
            if not name or not exec_raw:
                continue
            exec_clean = FIELD_CODE_RE.sub("", exec_raw).strip()
            desktop_id = Path(path).stem
            wm_class = data.get("StartupWMClass", "")
            classes = [c for c in [wm_class, desktop_id] if c]
            try:
                first_tok = Path(shlex.split(exec_clean)[0]).name
                if first_tok and first_tok not in classes:
                    classes.append(first_tok)
            except ValueError:
                first_tok = exec_clean.split()[0]

            apps[desktop_id] = {
                "name": name,
                "exec": exec_clean,
                "pattern": first_tok,
                "classes": ",".join(classes),
                "icon": data.get("Icon", ""),
                "is_flatpak": "flatpak" if "/flatpak/" in path or "flatpak run " in exec_clean else "",
            }
    return sorted(apps.values(), key=lambda a: a["name"].lower())


def resolve_entry_icon(entry: WorkspaceEntry, app_icons: dict[str, str]) -> QIcon:
    """Resolve a friendly system icon for a WorkspaceEntry."""
    candidates: list[str] = []
    if entry.name.lower() in app_icons:
        candidates.append(app_icons[entry.name.lower()])
    if entry.pattern:
        candidates.append(entry.pattern)
    for cls in entry.classes.split(","):
        cls = cls.strip()
        if cls:
            candidates.append(cls)
    for cand in candidates:
        icon = QIcon.fromTheme(cand)
        if not icon.isNull():
            return icon
    if entry.desktop == 0:
        return QIcon.fromTheme("process-stop")
    return QIcon.fromTheme("application-x-executable")


class AppPickerDialog(QDialog):
    """Searchable dialog listing installed .desktop applications."""

    def __init__(self, parent: QWidget | None = None, apps: list[dict[str, str]] | None = None) -> None:
        super().__init__(parent)
        self.setWindowTitle("Choose an Installed App")
        self.resize(540, 440)
        self.selected_app: dict[str, str] | None = None
        self.apps = apps if apps is not None else scan_desktop_apps()

        layout = QVBoxLayout(self)
        layout.setSpacing(10)

        hint = QLabel("Search for an app installed on your computer and double-click it:")
        layout.addWidget(hint)

        self.search = QLineEdit()
        self.search.setPlaceholderText("Type app name (e.g. Firefox, VS Code, Terminal, Steam)...")
        self.search.setClearButtonEnabled(True)
        self.search.textChanged.connect(self._filter)
        layout.addWidget(self.search)

        self.list_widget = QListWidget()
        self.list_widget.setIconSize(QSize(24, 24))
        self.list_widget.itemDoubleClicked.connect(self._accept_selected)
        layout.addWidget(self.list_widget)

        buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
        buttons.accepted.connect(self._accept_selected)
        buttons.rejected.connect(self.reject)
        layout.addWidget(buttons)

        self._populate("")
        self.search.setFocus()

    def _populate(self, query: str) -> None:
        self.list_widget.clear()
        q = query.strip().lower()
        for app in self.apps:
            exec_base = Path(app["exec"].split()[0]).name if app["exec"] else ""
            if q and q not in app["name"].lower() and q not in app["exec"].lower() and q not in exec_base.lower():
                continue
            display = f"{app['name']}  ({exec_base})" if exec_base else app["name"]
            item = QListWidgetItem(display)
            if app["icon"]:
                icon = QIcon.fromTheme(app["icon"])
                if not icon.isNull():
                    item.setIcon(icon)
            item.setData(Qt.ItemDataRole.UserRole, app)
            self.list_widget.addItem(item)
        if self.list_widget.count() > 0:
            self.list_widget.setCurrentRow(0)

    def _filter(self, text: str) -> None:
        self._populate(text)

    def _accept_selected(self) -> None:
        item = self.list_widget.currentItem()
        if not item:
            if self.list_widget.count() == 0:
                return
            self.list_widget.setCurrentRow(0)
            item = self.list_widget.currentItem()
        if item:
            self.selected_app = item.data(Qt.ItemDataRole.UserRole)
            self.accept()


class OpenWindowPickerDialog(QDialog):
    """Dialog showing currently open KWin windows so users can copy resourceClass."""

    def __init__(self, parent: QWidget | None = None) -> None:
        super().__init__(parent)
        self.setWindowTitle("Detect from Open Window")
        self.resize(660, 360)
        self.selected_row: tuple[str, str, str, str] | None = None

        layout = QVBoxLayout(self)
        hint = QLabel("Double-click an open window below to automatically fill its window ID and Desktop:")
        layout.addWidget(hint)

        self.table = QTableWidget(0, 4)
        self.table.setHorizontalHeaderLabels(["Desktop", "Window Class", "Window Name", "Title"])
        self.table.setSelectionBehavior(QAbstractItemView.SelectionBehavior.SelectRows)
        self.table.setSelectionMode(QAbstractItemView.SelectionMode.SingleSelection)
        self.table.setEditTriggers(QAbstractItemView.EditTrigger.NoEditTriggers)
        self.table.horizontalHeader().setSectionResizeMode(3, QHeaderView.ResizeMode.Stretch)
        self.table.doubleClicked.connect(self._accept_selected)
        layout.addWidget(self.table)

        btn_row = QHBoxLayout()
        refresh_btn = QPushButton(QIcon.fromTheme("view-refresh"), "Refresh")
        refresh_btn.clicked.connect(self._load)
        btn_row.addWidget(refresh_btn)
        btn_row.addStretch()

        buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
        buttons.accepted.connect(self._accept_selected)
        buttons.rejected.connect(self.reject)
        btn_row.addWidget(buttons)
        layout.addLayout(btn_row)

        self._load()

    def _load(self) -> None:
        rows = list_open_kwin_windows()
        self.table.setRowCount(0)
        for desks, cls, name, caption in rows:
            r = self.table.rowCount()
            self.table.insertRow(r)
            for c, val in enumerate([desks, cls, name or "-", caption]):
                item = QTableWidgetItem(val)
                item.setData(Qt.ItemDataRole.UserRole, (desks, cls, name, caption))
                self.table.setItem(r, c, item)
        self.table.resizeColumnsToContents()
        self.table.horizontalHeader().setSectionResizeMode(3, QHeaderView.ResizeMode.Stretch)

    def _accept_selected(self) -> None:
        row = self.table.currentRow()
        if row < 0:
            return
        self.selected_row = self.table.item(row, 0).data(Qt.ItemDataRole.UserRole)
        self.accept()


