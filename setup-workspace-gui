STOP_CLI = SCRIPT_DIR / "stop-workspace"

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "start-workspace"
CONFIG_FILE = CONFIG_DIR / "workspace.conf"
AUTOSTART_FILE = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "autostart" / "start-workspace.desktop"
BIN_DIR = Path.home() / ".local" / "bin"

CONFIG_HEADER = """# Workspace Manager Configuration
# Format: DESKTOP|NAME|PROC_PATTERN|WINDOW_CLASSES|FLAGS|COMMAND
#   DESKTOP        : 1-based Virtual Desktop number (0 = close-only for stop-workspace)
#   NAME           : Human-readable application name
#   PROC_PATTERN   : Pattern used by pgrep -f / pkill -f
#   WINDOW_CLASSES : Comma-separated KWin resourceClass / resourceName values
#   FLAGS          : Comma-separated flags: keep_open, flatpak, check_cmd, check_arg1, close_only
#   COMMAND        : Shell command to launch the application
"""

FIELD_CODE_RE = re.compile(r"\s+%[fFuUdDnNickvm]")


@dataclass
class WorkspaceEntry:
    desktop: int
    name: str
    pattern: str
    classes: str
    flags: str
    cmd: str

    def to_line(self) -> str:
        return f"{self.desktop}|{self.name}|{self.pattern}|{self.classes}|{self.flags}|{self.cmd}"


def parse_config() -> list[WorkspaceEntry]:
    entries: list[WorkspaceEntry] = []
    if not CONFIG_FILE.exists():
        return entries
    for raw in CONFIG_FILE.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = raw.split("|", 5)
        while len(parts) < 6:
            parts.append("")
        try:
            desktop = int(parts[0].strip())
        except ValueError:
            desktop = 1
        entries.append(
            WorkspaceEntry(
                desktop=desktop,
                name=parts[1].strip(),
                pattern=parts[2].strip(),
                classes=parts[3].strip(),
                flags=parts[4].strip(),
                cmd=parts[5].strip(),
            )
        )
    return entries


def save_config(entries: list[WorkspaceEntry]) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    lines = [CONFIG_HEADER.rstrip(), ""]
    for entry in entries:
        lines.append(entry.to_line())
    CONFIG_FILE.write_text("\n".join(lines) + "\n", encoding="utf-8")


def query_kwin_desktop_count() -> int | None:
    if not shutil.which("qdbus6"):
        return None
    res = subprocess.run(
        ["qdbus6", "org.kde.KWin", "/VirtualDesktopManager", "count"],
        capture_output=True,
        text=True,
        check=False,
    )
    val = res.stdout.strip()
    return int(val) if val.isdigit() else None


def list_open_kwin_windows() -> list[tuple[str, str, str, str]]:
    """Return [(desktops, resourceClass, resourceName, caption), ...] via KWin Scripting + Gio."""
    if not shutil.which("qdbus6"):
        return []
    try:
        import gi

        gi.require_version("Gio", "2.0")
        from gi.repository import Gio, GLib
    except Exception:
        return []

    rows: list[tuple[str, str, str, str]] = []
    xml = """<node><interface name="org.startworkspace.GuiWinProbe">
      <method name="Report">
        <arg type="s" name="cls" direction="in"/>
        <arg type="s" name="name" direction="in"/>
        <arg type="s" name="desktops" direction="in"/>
        <arg type="s" name="caption" direction="in"/>
      </method>
      <method name="Done"/>
    </interface></node>"""

    loop = GLib.MainLoop()
    node = Gio.DBusNodeInfo.new_for_xml(xml)
    tmp_path: str | None = None
    script_name = f"gui_winprobe_{os.getpid()}"

    def on_call(conn, sender, path, iface, method, params, inv):
        if method == "Report":
            cls, name, desks, caption = params.unpack()
            rows.append((desks, cls, name, caption))
            inv.return_value(None)
        elif method == "Done":
            inv.return_value(None)
            loop.quit()

    def on_acquired(conn, name):
        nonlocal tmp_path
        conn.register_object("/Probe", node.interfaces[0], on_call, None, None)
        js = """
var clients = workspace.windowList();
for (var i = 0; i < clients.length; i++) {
    var c = clients[i];
    if (!c.normalWindow) continue;
    var dList = [];
    for (var j = 0; j < c.desktops.length; j++) {
        dList.push(workspace.desktops.indexOf(c.desktops[j]) + 1);
    }
    callDBus("org.startworkspace.GuiWinProbe", "/Probe", "org.startworkspace.GuiWinProbe", "Report",
        String(c.resourceClass || ""), String(c.resourceName || ""),
        dList.length ? dList.join(",") : "all", String(c.caption || ""));
}
callDBus("org.startworkspace.GuiWinProbe", "/Probe", "org.startworkspace.GuiWinProbe", "Done");
"""
        with tempfile.NamedTemporaryFile("w", suffix=".js", delete=False) as f:
            f.write(js)
            tmp_path = f.name
        subprocess.run(
            ["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.loadScript", tmp_path, script_name],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        subprocess.run(
            ["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.start"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        GLib.timeout_add(1500, loop.quit)

    owner_id = Gio.bus_own_name(
        Gio.BusType.SESSION,
        "org.startworkspace.GuiWinProbe",
        Gio.BusNameOwnerFlags.NONE,
        on_acquired,
        None,
        None,
    )
    try:
        loop.run()
    finally:
        Gio.bus_unown_name(owner_id)
        subprocess.run(
            ["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.unloadScript", script_name],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if tmp_path and os.path.exists(tmp_path):
            os.unlink(tmp_path)
    return rows


def scan_desktop_apps() -> list[dict[str, str]]:
    """Scan installed .desktop files for quick app selection."""
    dirs = [
        "/usr/share/applications",
        str(Path.home() / ".local/share/applications"),
        "/var/lib/flatpak/exports/share/applications",
        str(Path.home() / ".local/share/flatpak/exports/share/applications"),
    ]
    apps: dict[str, dict[str, str]] = {}
    for d in dirs:
        if not os.path.isdir(d):
            continue
        for path in glob.glob(os.path.join(d, "*.desktop")):
            try:
                text = Path(path).read_text(encoding="utf-8", errors="ignore")
            except OSError:
                continue
            in_entry = False
            data: dict[str, str] = {}
            for line in text.splitlines():
                stripped = line.strip()
                if stripped.startswith("["):
                    in_entry = stripped == "[Desktop Entry]"
                    continue
                if not in_entry or "=" not in stripped or stripped.startswith("#"):
                    continue
                k, v = stripped.split("=", 1)
                data.setdefault(k.strip(), v.strip())

            if data.get("Type") != "Application":
                continue
            if data.get("NoDisplay", "").lower() == "true" or data.get("Hidden", "").lower() == "true":
                continue
            name = data.get("Name", "")
            exec_raw = data.get("Exec", "")
            if not name or not exec_raw:
                continue
            exec_clean = FIELD_CODE_RE.sub("", exec_raw).strip()
            desktop_id = Path(path).stem
            wm_class = data.get("StartupWMClass", "")
            classes = [c for c in [wm_class, desktop_id] if c]
            try:
                first_tok = Path(shlex.split(exec_clean)[0]).name
                if first_tok and first_tok not in classes:
                    classes.append(first_tok)
            except ValueError:
                first_tok = exec_clean.split()[0]

            apps[desktop_id] = {
                "name": name,
                "exec": exec_clean,
                "pattern": first_tok,
                "classes": ",".join(classes),
                "icon": data.get("Icon", ""),
                "is_flatpak": "flatpak" if "/flatpak/" in path or "flatpak run " in exec_clean else "",
            }
    return sorted(apps.values(), key=lambda a: a["name"].lower())


class AppPickerDialog(QDialog):
    """Searchable dialog listing installed .desktop applications."""

    def __init__(self, parent: QWidget | None = None) -> None:
        super().__init__(parent)
        self.setWindowTitle("Pick Installed Application")
        self.resize(560, 440)
        self.selected_app: dict[str, str] | None = None
        self.apps = scan_desktop_apps()

        layout = QVBoxLayout(self)
        self.search = QLineEdit()
        self.search.setPlaceholderText("Search installed apps (e.g. Firefox, VS Code, Steam)...")
        self.search.textChanged.connect(self._filter)
        layout.addWidget(self.search)

        self.list_widget = QListWidget()
        self.list_widget.itemDoubleClicked.connect(self._accept_selected)
        layout.addWidget(self.list_widget)

        buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
        buttons.accepted.connect(self._accept_selected)
        buttons.rejected.connect(self.reject)
        layout.addWidget(buttons)

        self._populate("")

    def _populate(self, query: str) -> None:
        self.list_widget.clear()
        q = query.strip().lower()
        for app in self.apps:
            if q and q not in app["name"].lower() and q not in app["exec"].lower():
                continue
            item = QListWidgetItem(f"{app['name']}  —  {app['exec']}")
            if app["icon"]:
                icon = QIcon.fromTheme(app["icon"])
                if not icon.isNull():
                    item.setIcon(icon)
            item.setData(Qt.ItemDataRole.UserRole, app)
            self.list_widget.addItem(item)

    def _filter(self, text: str) -> None:
        self._populate(text)

    def _accept_selected(self) -> None:
        item = self.list_widget.currentItem()
        if not item:
            return
        self.selected_app = item.data(Qt.ItemDataRole.UserRole)
        self.accept()


class OpenWindowPickerDialog(QDialog):
    """Dialog showing currently open KWin windows so users can copy resourceClass."""

    def __init__(self, parent: QWidget | None = None) -> None:
        super().__init__(parent)
        self.setWindowTitle("Pick Open KWin Window")
        self.resize(680, 360)
        self.selected_row: tuple[str, str, str, str] | None = None

        layout = QVBoxLayout(self)
        hint = QLabel("Double-click an open window to copy its KWin resourceClass / resourceName and Desktop:")
        layout.addWidget(hint)

        self.table = QTableWidget(0, 4)
        self.table.setHorizontalHeaderLabels(["Desktop", "resourceClass", "resourceName", "Window Title"])
        self.table.setSelectionBehavior(QAbstractItemView.SelectionBehavior.SelectRows)
        self.table.setSelectionMode(QAbstractItemView.SelectionMode.SingleSelection)
        self.table.setEditTriggers(QAbstractItemView.EditTrigger.NoEditTriggers)
        self.table.horizontalHeader().setSectionResizeMode(3, QHeaderView.ResizeMode.Stretch)
        self.table.doubleClicked.connect(self._accept_selected)
        layout.addWidget(self.table)

        btn_row = QHBoxLayout()
        refresh_btn = QPushButton("Refresh")
        refresh_btn.clicked.connect(self._load)
        btn_row.addWidget(refresh_btn)
        btn_row.addStretch()

        buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
        buttons.accepted.connect(self._accept_selected)
        buttons.rejected.connect(self.reject)
        btn_row.addWidget(buttons)
        layout.addLayout(btn_row)

        self._load()

    def _load(self) -> None:
        rows = list_open_kwin_windows()
        self.table.setRowCount(0)
        for desks, cls, name, caption in rows:
            r = self.table.rowCount()
            self.table.insertRow(r)
            for c, val in enumerate([desks, cls, name or "-", caption]):
                item = QTableWidgetItem(val)
                item.setData(Qt.ItemDataRole.UserRole, (desks, cls, name, caption))
                self.table.setItem(r, c, item)
        self.table.resizeColumnsToContents()
        self.table.horizontalHeader().setSectionResizeMode(3, QHeaderView.ResizeMode.Stretch)

    def _accept_selected(self) -> None:
        row = self.table.currentRow()
        if row < 0:
            return
        self.selected_row = self.table.item(row, 0).data(Qt.ItemDataRole.UserRole)
        self.accept()


class EntryDialog(QDialog):
    """Add or edit a WorkspaceEntry."""

    def __init__(self, entry: WorkspaceEntry | None = None, parent: QWidget | None = None) -> None:
        super().__init__(parent)
        self.setWindowTitle("Edit Application" if entry else "Add Application")
        self.resize(560, 400)

        layout = QVBoxLayout(self)

        quick_row = QHBoxLayout()
        pick_app_btn = QPushButton(QIcon.fromTheme("applications-other"), "Pick Installed App...")
        pick_app_btn.clicked.connect(self._pick_installed_app)
        pick_win_btn = QPushButton(QIcon.fromTheme("window-duplicate"), "Pick Open Window...")
        pick_win_btn.clicked.connect(self._pick_open_window)
        quick_row.addWidget(pick_app_btn)
        quick_row.addWidget(pick_win_btn)
        quick_row.addStretch()
        layout.addLayout(quick_row)

        form = QFormLayout()
        self.desktop_spin = QSpinBox()
        self.desktop_spin.setRange(1, 20)
        self.desktop_spin.setValue(entry.desktop if entry and entry.desktop > 0 else 1)

        self.close_only_cb = QCheckBox("Close-only target (stop-workspace only, do not launch)")
        self.close_only_cb.toggled.connect(self._on_close_only_toggled)

        desk_box = QHBoxLayout()
        desk_box.addWidget(self.desktop_spin)
        desk_box.addWidget(self.close_only_cb)
        desk_box.addStretch()
        form.addRow("Virtual Desktop:", desk_box)

        self.name_edit = QLineEdit(entry.name if entry else "")
        self.name_edit.setPlaceholderText("e.g. Firefox or VS Code")
        form.addRow("Display Name:", self.name_edit)

        cmd_row = QHBoxLayout()
        self.cmd_edit = QLineEdit(entry.cmd if entry else "")
        self.cmd_edit.setPlaceholderText('e.g. code "/path/to/project" or flatpak run ...')
        browse_btn = QPushButton("Browse...")
        browse_btn.clicked.connect(self._browse_cmd)
        cmd_row.addWidget(self.cmd_edit)
        cmd_row.addWidget(browse_btn)
        form.addRow("Launch Command:", cmd_row)

        self.pattern_edit = QLineEdit(entry.pattern if entry else "")
        self.pattern_edit.setPlaceholderText("Process match for pgrep/pkill (auto-filled if blank)")
        form.addRow("Process Pattern:", self.pattern_edit)

        self.classes_edit = QLineEdit(entry.classes if entry else "")
        self.classes_edit.setPlaceholderText("Comma-separated KWin resourceClass/resourceName")
        form.addRow("KWin Window Classes:", self.classes_edit)

        flags_group = QGroupBox("Options")
        flags_layout = QVBoxLayout(flags_group)
        self.keep_open_cb = QCheckBox("Keep open on stop-workspace (unless --all is passed)")
        self.flatpak_cb = QCheckBox("Flatpak app (run 'flatpak kill' on stop)")
        self.check_cmd_cb = QCheckBox("Only launch if executable/command exists (check_cmd)")
        self.check_arg1_cb = QCheckBox("Only launch if first file argument exists (check_arg1)")
        for cb in (self.keep_open_cb, self.flatpak_cb, self.check_cmd_cb, self.check_arg1_cb):
            flags_layout.addWidget(cb)
        layout.addLayout(form)
        layout.addWidget(flags_group)

        if entry:
            flag_set = {f.strip() for f in entry.flags.split(",") if f.strip()}
            self.keep_open_cb.setChecked("keep_open" in flag_set)
            self.flatpak_cb.setChecked("flatpak" in flag_set)
            self.check_cmd_cb.setChecked("check_cmd" in flag_set)
            self.check_arg1_cb.setChecked("check_arg1" in flag_set)
            if "close_only" in flag_set or entry.desktop == 0:
                self.close_only_cb.setChecked(True)

        buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Save | QDialogButtonBox.StandardButton.Cancel)
        buttons.accepted.connect(self._validate_and_accept)
        buttons.rejected.connect(self.reject)
        layout.addWidget(buttons)

    def _on_close_only_toggled(self, checked: bool) -> None:
        self.desktop_spin.setEnabled(not checked)
        self.cmd_edit.setEnabled(not checked)

    def _browse_cmd(self) -> None:
        path, _ = QFileDialog.getOpenFileName(self, "Select Executable or Script", str(Path.home()))
        if path:
            quoted = f'"{path}"' if " " in path else path
            self.cmd_edit.setText(quoted)
            if not self.name_edit.text().strip():
                self.name_edit.setText(Path(path).stem)
            if not self.pattern_edit.text().strip():
                self.pattern_edit.setText(Path(path).name)

    def _pick_installed_app(self) -> None:
        dlg = AppPickerDialog(self)
        if dlg.exec() == QDialog.DialogCode.Accepted and dlg.selected_app:
            app = dlg.selected_app
            self.name_edit.setText(app["name"])
            self.cmd_edit.setText(app["exec"])
            self.pattern_edit.setText(app["pattern"])
            self.classes_edit.setText(app["classes"])
            self.flatpak_cb.setChecked(bool(app["is_flatpak"]))

    def _pick_open_window(self) -> None:
        dlg = OpenWindowPickerDialog(self)
        if dlg.exec() == QDialog.DialogCode.Accepted and dlg.selected_row:
            desks, cls, name, caption = dlg.selected_row
            classes = [c for c in [cls, name] if c]
            self.classes_edit.setText(",".join(dict.fromkeys(classes)))
            first_desk = desks.split(",")[0].strip()
            if first_desk.isdigit() and int(first_desk) >= 1 and not self.close_only_cb.isChecked():
                self.desktop_spin.setValue(int(first_desk))
            if not self.pattern_edit.text().strip() and cls:
                self.pattern_edit.setText(cls)
            if not self.name_edit.text().strip():
                self.name_edit.setText(caption.split(" - ")[-1][:30] if caption else cls)

    def _validate_and_accept(self) -> None:
        name = self.name_edit.text().strip()
        cmd = self.cmd_edit.text().strip()
        pattern = self.pattern_edit.text().strip()
        classes = self.classes_edit.text().strip()

        if not name:
            QMessageBox.warning(self, "Validation", "Display Name cannot be empty.")
            return
        if not self.close_only_cb.isChecked() and not cmd:
            QMessageBox.warning(self, "Validation", "Launch Command cannot be empty.")
            return

        if not pattern and cmd:
            try:
                pattern = Path(shlex.split(cmd)[0]).name
            except ValueError:
                pattern = cmd.split()[0]
            self.pattern_edit.setText(pattern)

        if not pattern:
            QMessageBox.warning(self, "Validation", "Process Pattern cannot be empty.")
            return

        if not classes:
            self.classes_edit.setText(pattern)

        for field_name, val in [("Name", name), ("Command", cmd), ("Pattern", pattern), ("Classes", classes)]:
            if "|" in val:
                QMessageBox.warning(self, "Validation", f"{field_name} cannot contain the '|' character.")
                return
        self.accept()

    def build_entry(self) -> WorkspaceEntry:
        flags: list[str] = []
        if self.close_only_cb.isChecked():
            flags.append("close_only")
        if self.keep_open_cb.isChecked():
            flags.append("keep_open")
        if self.flatpak_cb.isChecked() or self.cmd_edit.text().strip().startswith("flatpak run "):
            if "flatpak" not in flags:
                flags.append("flatpak")
        if self.check_cmd_cb.isChecked():
            flags.append("check_cmd")
        if self.check_arg1_cb.isChecked():
            flags.append("check_arg1")

        return WorkspaceEntry(
            desktop=0 if self.close_only_cb.isChecked() else self.desktop_spin.value(),
            name=self.name_edit.text().strip(),
            pattern=self.pattern_edit.text().strip(),
            classes=self.classes_edit.text().strip(),
            flags=",".join(flags),
            cmd="" if self.close_only_cb.isChecked() else self.cmd_edit.text().strip(),
        )


