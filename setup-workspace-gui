        edit_btn.clicked.connect(self._edit_selected)
        remove_btn = QPushButton(QIcon.fromTheme("list-remove"), "Remove")
        remove_btn.clicked.connect(self._remove_selected)
        up_btn = QPushButton(QIcon.fromTheme("go-up"), "Up")
        up_btn.clicked.connect(lambda: self._move_selected(-1))
        down_btn = QPushButton(QIcon.fromTheme("go-down"), "Down")
        down_btn.clicked.connect(lambda: self._move_selected(1))

        preset_btn = QPushButton(QIcon.fromTheme("view-refresh"), "Load Preset")
        preset_menu = QMenu(preset_btn)
        preset_menu.addAction("Auto-detect installed apps (Recommended)", lambda: self._apply_preset("auto"))
        preset_menu.addAction("Minimal starter template", lambda: self._apply_preset("minimal"))
        preset_menu.addAction("Original personal setup", lambda: self._apply_preset("personal"))
        preset_btn.setMenu(preset_menu)

        for b in (add_btn, edit_btn, remove_btn, up_btn, down_btn):
            tb.addWidget(b)
        tb.addStretch()
        tb.addWidget(preset_btn)
        root.addLayout(tb)

        # Main table
        self.table = QTableWidget(0, 6)
        self.table.setHorizontalHeaderLabels(
            ["Desktop", "Application", "Launch Command", "KWin Classes", "Flags", "Pattern"]
        )
        self.table.setSelectionBehavior(QAbstractItemView.SelectionBehavior.SelectRows)
        self.table.setSelectionMode(QAbstractItemView.SelectionMode.SingleSelection)
        self.table.setEditTriggers(QAbstractItemView.EditTrigger.NoEditTriggers)
        self.table.horizontalHeader().setSectionResizeMode(2, QHeaderView.ResizeMode.Stretch)
        self.table.doubleClicked.connect(self._edit_selected)
        root.addWidget(self.table)

        # Bottom action bar
        bottom = QHBoxLayout()
        doctor_btn = QPushButton(QIcon.fromTheme("dialog-information"), "System Check (Doctor)")
        doctor_btn.clicked.connect(self._run_doctor)
        win_btn = QPushButton(QIcon.fromTheme("window-duplicate"), "Inspect Open Windows")
        win_btn.clicked.connect(self._inspect_windows)

        start_btn = QPushButton(QIcon.fromTheme("media-playback-start"), "Launch Workspace")
        start_btn.clicked.connect(lambda: self._run_async([str(START_CLI)], "Launching Workspace"))
        stop_btn = QPushButton(QIcon.fromTheme("media-playback-stop"), "Stop Workspace")
        stop_btn.clicked.connect(lambda: self._run_async([str(STOP_CLI)], "Stopping Workspace"))

        bottom.addWidget(doctor_btn)
        bottom.addWidget(win_btn)
        bottom.addStretch()
        bottom.addWidget(start_btn)
        bottom.addWidget(stop_btn)
        root.addLayout(bottom)

        if not CONFIG_FILE.exists() and SETUP_CLI.exists():
            subprocess.run([str(SETUP_CLI), "init", "--preset", "auto"], check=False)

        self._reload()

    def _reload(self) -> None:
        self.entries = parse_config()
        self.table.setRowCount(0)
        for entry in self.entries:
            r = self.table.rowCount()
            self.table.insertRow(r)
            desk_str = "Stop Only" if entry.desktop == 0 else f"Desktop {entry.desktop}"
            vals = [desk_str, entry.name, entry.cmd or "-", entry.classes or "-", entry.flags or "-", entry.pattern]
            for c, val in enumerate(vals):
                self.table.setItem(r, c, QTableWidgetItem(val))
        self.table.resizeColumnsToContents()
        self.table.horizontalHeader().setSectionResizeMode(2, QHeaderView.ResizeMode.Stretch)
        self._update_desktop_status()

    def _update_desktop_status(self) -> None:
        current = query_kwin_desktop_count()
        max_cfg = max((e.desktop for e in self.entries if e.desktop > 0), default=1)
        if current is None:
            self.desktops_lbl.setText("KDE Virtual Desktops: N/A")
            self.ensure_desk_btn.setEnabled(False)
        elif current < max_cfg:
            self.desktops_lbl.setText(f"KDE Virtual Desktops: {current} (need {max_cfg})")
            self.ensure_desk_btn.setEnabled(True)
        else:
            self.desktops_lbl.setText(f"KDE Virtual Desktops: {current} (OK)")
            self.ensure_desk_btn.setEnabled(False)

    def _persist(self, message: str) -> None:
        save_config(self.entries)
        self._reload()
        self.statusBar().showMessage(message, 4000)

    def _add_entry(self) -> None:
        dlg = EntryDialog(parent=self)
        if dlg.exec() == QDialog.DialogCode.Accepted:
            entry = dlg.build_entry()
            self.entries.append(entry)
            self._persist(f"Added '{entry.name}' to configuration.")

    def _edit_selected(self) -> None:
        row = self.table.currentRow()
        if row < 0 or row >= len(self.entries):
            QMessageBox.information(self, "Edit", "Please select an application row first.")
            return
        dlg = EntryDialog(self.entries[row], parent=self)
        if dlg.exec() == QDialog.DialogCode.Accepted:
            self.entries[row] = dlg.build_entry()
            self._persist(f"Updated '{self.entries[row].name}'.")
            self.table.selectRow(row)

    def _remove_selected(self) -> None:
        row = self.table.currentRow()
        if row < 0 or row >= len(self.entries):
            QMessageBox.information(self, "Remove", "Please select an application row first.")
            return
        name = self.entries[row].name
        ans = QMessageBox.question(self, "Confirm Removal", f"Remove '{name}' from workspace configuration?")
        if ans == QMessageBox.StandardButton.Yes:
            del self.entries[row]
            self._persist(f"Removed '{name}'.")

    def _move_selected(self, delta: int) -> None:
        row = self.table.currentRow()
        new_row = row + delta
        if row < 0 or new_row < 0 or new_row >= len(self.entries):
            return
        self.entries[row], self.entries[new_row] = self.entries[new_row], self.entries[row]
        self._persist("Reordered entries.")
        self.table.selectRow(new_row)

    def _apply_preset(self, preset: str) -> None:
        ans = QMessageBox.question(
            self,
            "Load Preset",
            f"Overwrite {CONFIG_FILE} using the '{preset}' preset?",
        )
        if ans != QMessageBox.StandardButton.Yes:
            return
        res = subprocess.run(
            [str(SETUP_CLI), "reset", "--preset", preset, "--yes"],
            capture_output=True,
            text=True,
            check=False,
        )
        if res.returncode != 0:
            QMessageBox.critical(self, "Error", res.stderr or res.stdout)
            return
        self._reload()
        self.statusBar().showMessage(f"Loaded '{preset}' preset.", 4000)

    def _ensure_desktops(self) -> None:
        res = subprocess.run([str(SETUP_CLI), "ensure-desktops"], capture_output=True, text=True, check=False)
        self._update_desktop_status()
        if res.returncode == 0:
            self.statusBar().showMessage("KDE Virtual Desktops updated.", 4000)
        else:
            QMessageBox.warning(self, "Virtual Desktops", res.stderr or res.stdout)

    def _toggle_autostart(self, enabled: bool) -> None:
        action = "enable" if enabled else "disable"
        res = subprocess.run([str(SETUP_CLI), "autostart", action], capture_output=True, text=True, check=False)
        if res.returncode == 0:
            self.statusBar().showMessage(f"Login autostart {action}d.", 4000)
        else:
            QMessageBox.warning(self, "Autostart", res.stderr or res.stdout)

    def _install_cli(self) -> None:
        res = subprocess.run([str(SETUP_CLI), "install"], capture_output=True, text=True, check=False)
        msg = (res.stdout + "\n" + res.stderr).strip()
        if res.returncode == 0:
            QMessageBox.information(self, "Install Complete", msg)
        else:
            QMessageBox.warning(self, "Install Error", msg)

    def _run_doctor(self) -> None:
        env = os.environ.copy()
        env["NO_COLOR"] = "1"
        res = subprocess.run([str(SETUP_CLI), "doctor"], capture_output=True, text=True, env=env, check=False)
        clean = re.sub(r"\x1b\[[0-9;]*m", "", res.stdout + res.stderr)
        CommandOutputDialog("System Check (Doctor)", clean, self).exec()

    def _inspect_windows(self) -> None:
        OpenWindowPickerDialog(self).exec()

    def _run_async(self, cmd: list[str], label: str) -> None:
        if self.proc and self.proc.state() != QProcess.ProcessState.NotRunning:
            QMessageBox.information(self, "Busy", "Another workspace command is still running.")
            return
        self.statusBar().showMessage(f"{label}...")
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.proc.finished.connect(lambda code, _status: self._on_proc_finished(label, code))
        self.proc.start(cmd[0], cmd[1:])

    def _on_proc_finished(self, label: str, code: int) -> None:
        output = bytes(self.proc.readAllStandardOutput()).decode("utf-8", errors="ignore") if self.proc else ""
        if code == 0:
            self.statusBar().showMessage(f"{label}: done.", 4000)
        else:
            CommandOutputDialog(f"{label} (exit {code})", output, self).exec()


def main() -> int:
    app = QApplication(sys.argv)
    app.setApplicationName("Workspace Setup")
    app.setDesktopFileName("start-workspace-setup")
    win = MainWindow()
    win.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
