#!/usr/bin/env bash
# ========================================================
# Auto-Stop Workspace Setup for CachyOS / KDE Plasma
# ========================================================

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/start-workspace/workspace.conf"

CLOSE_TERMINAL=false
FORCE=false

for arg in "$@"; do
    case "$arg" in
        -a|--all)
            CLOSE_TERMINAL=true
            ;;
        -f|--force)
            FORCE=true
            ;;
        -h|--help)
            echo "Usage: stop-workspace [OPTIONS]"
            echo "Close all workspace applications (Desktops 1 - 3)."
            echo ""
            echo "Options:"
            echo "  -a, --all    Also close keep-open apps (e.g. Ptyxis terminal)"
            echo "  -f, --force  Force-kill unresponsive processes (kill -9)"
            echo "  -h, --help   Show this help message"
            exit 0
            ;;
    esac
done

echo "[*] Stopping Workspace..."

# Helper to terminate background processes
close_proc() {
    local pattern="$1"
    local name="$2"

    if pgrep -f "$pattern" >/dev/null 2>&1; then
        echo "[-] Closing process: $name"
        if [ "$FORCE" = true ]; then
            pkill -9 -f "$pattern" >/dev/null 2>&1 || true
        else
            pkill -f "$pattern" >/dev/null 2>&1 || true
        fi
    fi
}

run_kwin_close() {
    local targets_js="$1"
    if ! command -v qdbus6 >/dev/null 2>&1; then
        return
    fi

    local tmp_script="/tmp/kwin_stop_$$.js"
    cat << EOF > "$tmp_script"
var targets = [
${targets_js}
];

var clients = workspace.windowList();
for (var i = 0; i < clients.length; i++) {
    var c = clients[i];
    if (!c.normalWindow) continue;
    var match = false;
    for (var j = 0; j < targets.length; j++) {
        if (c.resourceClass === targets[j] || c.resourceName === targets[j]) {
            match = true;
            break;
        }
    }
    if (match) {
        c.closeWindow();
    }
}
EOF

    local script_id
    script_id=$(qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$tmp_script" "stop_ws_$$" 2>/dev/null)
    qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.start >/dev/null 2>&1
    sleep 0.4
    qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript "stop_ws_$$" >/dev/null 2>&1
    rm -f "$tmp_script"
}

stop_from_config() {
    local targets_js=""
    local proc_entries=()
    local flatpak_ids=()

    while IFS= read -r line || [ -n "$line" ]; do
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue

        local desktop name proc_pattern win_classes flags cmd_str
        IFS='|' read -r desktop name proc_pattern win_classes flags cmd_str <<< "$line"

        local is_keep_open=false
        [[ ",$flags," == *",keep_open,"* ]] && is_keep_open=true

        if [ "$is_keep_open" = true ] && [ "$CLOSE_TERMINAL" = false ]; then
            proc_entries+=("KEEP|$proc_pattern|$name")
            continue
        fi

        if [ -n "$win_classes" ]; then
            local cls_arr=()
            IFS=',' read -ra cls_arr <<< "$win_classes"
            for cls in "${cls_arr[@]}"; do
                cls="${cls//\"/}"
                cls="${cls//\\/}"
                [ -z "$cls" ] && continue
                targets_js+="    \"${cls}\","$'\n'
            done
        fi

        if [[ ",$flags," == *",flatpak,"* ]] && [[ "$cmd_str" =~ flatpak[[:space:]]+run[[:space:]]+([^[:space:]]+) ]]; then
            flatpak_ids+=("${BASH_REMATCH[1]}")
        fi

        proc_entries+=("STOP|$proc_pattern|$name")
    done < "$CONFIG_FILE"

    # 1. Gracefully close windows via KWin Scripting
    run_kwin_close "$targets_js"
    sleep 0.8

    # 2. Stop Flatpak apps if active
    if command -v flatpak >/dev/null 2>&1; then
        for app_id in "${flatpak_ids[@]}"; do
            flatpak kill "$app_id" >/dev/null 2>&1 || true
        done
    fi

    # 3. Terminate remaining background processes
    for entry in "${proc_entries[@]}"; do
        local action pat app_name
        IFS='|' read -r action pat app_name <<< "$entry"
        if [ "$action" = "STOP" ]; then
            close_proc "$pat" "$app_name"
        elif pgrep -f "$pat" >/dev/null 2>&1; then
            echo "[i] $app_name left open (use 'stop-workspace --all' to close it as well)."
        fi
    done
}

stop_defaults() {
    local targets_js='
    "antigravity-ide",
    "brave-browser",
    "org.gnome.TextEditor",
    "anibase",
    "AniBase",
    "Twintaillauncher",
    "twintaillauncher",
    "client-win64-shipping.exe",
    "org.gnome.Resources",
    "resources",
    "org.hp.OmenSpace",
    "omen-gui"'

    if [ "$CLOSE_TERMINAL" = true ]; then
        targets_js+=',
    "org.gnome.Ptyxis",
    "ptyxis"'
    fi

    # 1. Gracefully close windows via KWin Scripting (Wayland Native)
    run_kwin_close "$targets_js"

    # Wait briefly for windows to close gracefully
    sleep 0.8

    # Stop Flatpak app if still running
    if command -v flatpak >/dev/null 2>&1; then
        flatpak kill app.twintaillauncher.ttl >/dev/null 2>&1 || true
    fi

    # Stop application processes
    close_proc "antigravity-ide" "Antigravity IDE"
    close_proc "brave" "Brave Browser"
    close_proc "gnome-text-editor" "Gnome Text Editor"
    close_proc "AniBase" "AniBase"
    close_proc "anibase" "AniBase Server/Tray"
    close_proc "twintaillauncher" "Twintail Launcher"
    close_proc "client-win64-shipping.exe" "Wuthering Waves"
    close_proc "resources" "Resources Monitor"
    close_proc "omen-gui" "Omen Space"

    if [ "$CLOSE_TERMINAL" = true ]; then
        close_proc "ptyxis" "Ptyxis Terminal"
    else
        if pgrep -x ptyxis >/dev/null 2>&1; then
            echo "[i] Ptyxis Terminal left open (use 'stop-workspace --all' to close the terminal as well)."
        fi
    fi
}

if [ -f "$CONFIG_FILE" ]; then
    stop_from_config
else
    stop_defaults
fi

# 3. Return focus to Desktop 1
if command -v qdbus6 >/dev/null 2>&1; then
    qdbus6 org.kde.KWin /KWin org.kde.KWin.setCurrentDesktop 1 >/dev/null 2>&1 || true
fi

# 4. Send desktop notification
if command -v notify-send >/dev/null 2>&1; then
    notify-send -i preferences-desktop-display "Workspace Setup" "All workspace applications have been closed!"
fi

echo "[✓] Done! All workspace applications have been stopped."
