write_config_by_preset() {
    local preset="${1:-auto}"
    case "$preset" in
        auto)     write_auto_config ;;
        personal) write_personal_config ;;
        minimal)  write_minimal_config ;;
        *)
            err "Unknown preset: $preset (valid: auto, minimal, personal)"
            return 1
            ;;
    esac
}

ensure_config_exists() {
    if [ ! -f "$CONFIG_FILE" ]; then
        info "Configuration file not found. Creating configuration (preset: auto)..."
        write_auto_config
        success "Created: $CONFIG_FILE"
    fi
}

cmd_init() {
    local force=false
    local preset="auto"

    while [ "$#" -gt 0 ]; do
        case "$1" in
            -f|--force) force=true; shift ;;
            --preset)   preset="${2:-}"; shift 2 ;;
            *) err "Unknown option for init: $1"; return 1 ;;
        esac
    done

    if [ -f "$CONFIG_FILE" ] && [ "$force" = false ]; then
        warn "Configuration already exists at: $CONFIG_FILE"
        info "Use 'setup-workspace init --force' or 'setup-workspace reset' to overwrite."
        return 0
    fi

    write_config_by_preset "$preset" || return 1
    success "Initialized configuration ($preset) at: $CONFIG_FILE"
}

load_config_lines() {
    CONFIG_LINES=()
    [ -f "$CONFIG_FILE" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
        CONFIG_LINES+=("$line")
    done < "$CONFIG_FILE"
}

cmd_list() {
    ensure_config_exists
    load_config_lines

    if [ "${#CONFIG_LINES[@]}" -eq 0 ]; then
        warn "No entries configured in $CONFIG_FILE"
        return 0
    fi

    printf "\n${BOLD}Workspace Configuration${RESET} (${DIM}%s${RESET})\n\n" "$CONFIG_FILE"
    printf "${BOLD}%-3s  %-7s  %-22s  %-20s  %-18s  %s${RESET}\n" "#" "Desktop" "Name" "Pattern" "Flags" "Command"
    printf "%s\n" "------------------------------------------------------------------------------------------------------------"

    local idx=1
    for line in "${CONFIG_LINES[@]}"; do
        local desktop name proc classes flags cmd
        IFS='|' read -r desktop name proc classes flags cmd <<< "$line"
        local desk_label="D${desktop}"
        [ "$desktop" = "0" ] && desk_label="stop"
        [ -z "$flags" ] && flags="-"
        [ -z "$cmd" ] && cmd="-"
        printf "%-3d  %-7s  %-22s  %-20s  %-18s  %s\n" \
            "$idx" "$desk_label" "${name:0:22}" "${proc:0:20}" "${flags:0:18}" "$cmd"
        idx=$((idx + 1))
    done
    echo ""
}

validate_no_pipe() {
    local val="$1"
    local field="$2"
    if [[ "$val" == *"|"* ]]; then
        err "Field '$field' cannot contain the '|' character."
        return 1
    fi
}

cmd_add() {
    ensure_config_exists

    local desktop="" name="" pattern="" classes="" cmd=""
    local flag_list=()
    local prompted=false

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --desktop)    desktop="${2:-}"; shift 2 ;;
            --name)       name="${2:-}"; shift 2 ;;
            --pattern)    pattern="${2:-}"; shift 2 ;;
            --classes)    classes="${2:-}"; shift 2 ;;
            --cmd)        cmd="${2:-}"; shift 2 ;;
            --keep-open)  flag_list+=("keep_open"); shift ;;
            --flatpak)    flag_list+=("flatpak"); shift ;;
            --close-only) flag_list+=("close_only"); shift ;;
            *) err "Unknown option for add: $1"; return 1 ;;
        esac
    done

    local is_close_only=false
    for f in "${flag_list[@]}"; do
        [ "$f" = "close_only" ] && is_close_only=true
    done

    if [ -z "$desktop" ]; then
        if [ "$is_close_only" = true ]; then
            desktop="0"
        else
            prompted=true
            read -r -p "Virtual Desktop number (1, 2, 3, ... or 0 for close-only) [1]: " desktop
            desktop="${desktop:-1}"
        fi
    fi

    if ! [[ "$desktop" =~ ^[0-9]+$ ]]; then
        err "Desktop must be a non-negative integer (got: '$desktop')."
        return 1
    fi
    [ "$desktop" = "0" ] && is_close_only=true

    if [ -z "$name" ]; then
        prompted=true
        read -r -p "Application display name (e.g. VS Code): " name
    fi
    if [ -z "$name" ]; then
        err "Application name cannot be empty."
        return 1
    fi

    if [ -z "$cmd" ] && [ "$is_close_only" = false ]; then
        prompted=true
        read -r -p "Launch command (e.g. code ~/project or flatpak run ...): " cmd
        if [ -z "$cmd" ]; then
            err "Launch command cannot be empty unless --close-only is used."
            return 1
        fi
    fi

    if [ -z "$pattern" ]; then
        local default_pat=""
        if [ -n "$cmd" ]; then
            default_pat="${cmd%% *}"
            default_pat="${default_pat##*/}"
            default_pat="${default_pat//\"/}"
        fi
        prompted=true
        read -r -p "Process match pattern for pgrep/pkill [${default_pat}]: " pattern
        pattern="${pattern:-$default_pat}"
    fi
    if [ -z "$pattern" ]; then
        err "Process pattern cannot be empty."
        return 1
    fi

    if [ -z "$classes" ]; then
        prompted=true
        read -r -p "KWin window resourceClass/resourceName (comma-separated, tip: run 'setup-workspace windows') [${pattern}]: " classes
        classes="${classes:-$pattern}"
    fi

    if [ "$is_close_only" = false ]; then
        if [ "$prompted" = true ] && [ "${#flag_list[@]}" -eq 0 ]; then
            local ans
            read -r -p "Keep app open on 'stop-workspace' unless '--all' is used? [y/N]: " ans
            [[ "$ans" =~ ^[Yy]$ ]] && flag_list+=("keep_open")
        fi

        if [[ "$cmd" == flatpak\ run\ * ]] && [[ " ${flag_list[*]} " != *" flatpak "* ]]; then
            flag_list+=("flatpak")
        fi
    fi

    validate_no_pipe "$name" "name" || return 1
    validate_no_pipe "$pattern" "pattern" || return 1
    validate_no_pipe "$classes" "classes" || return 1
    validate_no_pipe "$cmd" "cmd" || return 1

    local flags_joined=""
    if [ "${#flag_list[@]}" -gt 0 ]; then
        local IFS=','
        flags_joined="${flag_list[*]}"
    fi

    printf "%s|%s|%s|%s|%s|%s\n" "$desktop" "$name" "$pattern" "$classes" "$flags_joined" "$cmd" >> "$CONFIG_FILE"
    success "Added '$name' (Desktop $desktop) to $CONFIG_FILE"
}

cmd_edit() {
    ensure_config_exists
    load_config_lines

    if [ "${#CONFIG_LINES[@]}" -eq 0 ]; then
        warn "Configuration is empty."
        return 0
    fi

    local target_idx=""
    local new_desktop="" new_name="" new_pattern="" new_classes="" new_cmd=""
    local set_flags=false
    local flag_list=()

    if [ "$#" -gt 0 ] && [[ "$1" =~ ^[0-9]+$ ]]; then
        target_idx="$1"
        shift
    fi

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --desktop)    new_desktop="${2:-}"; shift 2 ;;
            --name)       new_name="${2:-}"; shift 2 ;;
            --pattern)    new_pattern="${2:-}"; shift 2 ;;
            --classes)    new_classes="${2:-}"; shift 2 ;;
            --cmd)        new_cmd="${2:-}"; shift 2 ;;
            --keep-open)  set_flags=true; flag_list+=("keep_open"); shift ;;
            --flatpak)    set_flags=true; flag_list+=("flatpak"); shift ;;
            --close-only) set_flags=true; flag_list+=("close_only"); shift ;;
            *) err "Unknown option for edit: $1"; return 1 ;;
        esac
    done

    if [ -z "$target_idx" ]; then
        cmd_list
        read -r -p "Enter entry # to edit (or blank to cancel): " target_idx
        [ -z "$target_idx" ] && { info "Cancelled."; return 0; }
    fi

    if ! [[ "$target_idx" =~ ^[0-9]+$ ]] || [ "$target_idx" -lt 1 ] || [ "$target_idx" -gt "${#CONFIG_LINES[@]}" ]; then
        err "Invalid entry number: $target_idx (valid: 1-${#CONFIG_LINES[@]})."
        return 1
    fi

    local cur_line="${CONFIG_LINES[$((target_idx - 1))]}"
    local cur_desktop cur_name cur_pattern cur_classes cur_flags cur_cmd
    IFS='|' read -r cur_desktop cur_name cur_pattern cur_classes cur_flags cur_cmd <<< "$cur_line"

    local interactive=false
    if [ -z "$new_desktop$new_name$new_pattern$new_classes$new_cmd" ] && [ "$set_flags" = false ]; then
        interactive=true
        info "Editing entry #$target_idx ($cur_name). Press Enter to keep current value."
        read -r -p "Virtual Desktop [${cur_desktop}]: " new_desktop
        read -r -p "Display Name [${cur_name}]: " new_name
        read -r -p "Process Pattern [${cur_pattern}]: " new_pattern
        read -r -p "KWin Window Classes [${cur_classes}]: " new_classes
        read -r -p "Launch Command [${cur_cmd}]: " new_cmd
        local ans_flags
        read -r -p "Flags [${cur_flags}] (keep_open,flatpak,check_cmd,check_arg1,close_only or '-' to clear): " ans_flags
        if [ "$ans_flags" = "-" ]; then
            cur_flags=""
        elif [ -n "$ans_flags" ]; then
            cur_flags="$ans_flags"
        fi
    fi

    local final_desktop="${new_desktop:-$cur_desktop}"
    local final_name="${new_name:-$cur_name}"
    local final_pattern="${new_pattern:-$cur_pattern}"
    local final_classes="${new_classes:-$cur_classes}"
    local final_cmd="${new_cmd:-$cur_cmd}"
    local final_flags="$cur_flags"

    if [ "$interactive" = false ] && [ "$set_flags" = true ]; then
        local IFS=','
        final_flags="${flag_list[*]}"
    fi

    if ! [[ "$final_desktop" =~ ^[0-9]+$ ]]; then
        err "Desktop must be a non-negative integer (got: '$final_desktop')."
        return 1
    fi

    validate_no_pipe "$final_name" "name" || return 1
    validate_no_pipe "$final_pattern" "pattern" || return 1
    validate_no_pipe "$final_classes" "classes" || return 1
    validate_no_pipe "$final_flags" "flags" || return 1
    validate_no_pipe "$final_cmd" "cmd" || return 1

    local updated_line="${final_desktop}|${final_name}|${final_pattern}|${final_classes}|${final_flags}|${final_cmd}"

    local tmp_file
    tmp_file="$(mktemp)"
    local active_idx=0
    while IFS= read -r line || [ -n "$line" ]; do
        if [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]]; then
            printf "%s\n" "$line" >> "$tmp_file"
            continue
        fi
        active_idx=$((active_idx + 1))
        if [ "$active_idx" -eq "$target_idx" ]; then
            printf "%s\n" "$updated_line" >> "$tmp_file"
        else
            printf "%s\n" "$line" >> "$tmp_file"
        fi
    done < "$CONFIG_FILE"

    mv "$tmp_file" "$CONFIG_FILE"
    success "Updated entry #$target_idx ($final_name)."
}

cmd_remove() {
    ensure_config_exists
    load_config_lines

    if [ "${#CONFIG_LINES[@]}" -eq 0 ]; then
        warn "Configuration is empty."
        return 0
    fi

    local target_idx="${1:-}"
    if [ -z "$target_idx" ]; then
        cmd_list
        read -r -p "Enter entry # to remove (or blank to cancel): " target_idx
        [ -z "$target_idx" ] && { info "Cancelled."; return 0; }
    fi

    if ! [[ "$target_idx" =~ ^[0-9]+$ ]] || [ "$target_idx" -lt 1 ] || [ "$target_idx" -gt "${#CONFIG_LINES[@]}" ]; then
        err "Invalid entry number: $target_idx (valid: 1-${#CONFIG_LINES[@]})."
        return 1
    fi

    local tmp_file
    tmp_file="$(mktemp)"
    local active_idx=0
    local removed_name=""

    while IFS= read -r line || [ -n "$line" ]; do
        if [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]]; then
            printf "%s\n" "$line" >> "$tmp_file"
            continue
        fi
        active_idx=$((active_idx + 1))
        if [ "$active_idx" -eq "$target_idx" ]; then
            IFS='|' read -r _ removed_name _ <<< "$line"
            continue
        fi
        printf "%s\n" "$line" >> "$tmp_file"
    done < "$CONFIG_FILE"

    mv "$tmp_file" "$CONFIG_FILE"
    success "Removed entry #$target_idx ($removed_name)."
}

cmd_windows() {
    if ! command -v qdbus6 >/dev/null 2>&1; then
        err "qdbus6 is not installed; cannot inspect KWin windows."
        return 1
    fi

    local pick=false
    for arg in "$@"; do
        case "$arg" in
            --pick|-p) pick=true ;;
            *) err "Unknown option for windows: $arg"; return 1 ;;
        esac
    done

    if [ "$pick" = true ]; then
        info "Click any open window to inspect its KWin resourceClass & resourceName..."
        qdbus6 org.kde.KWin /KWin org.kde.KWin.queryWindowInfo
        return $?
    fi

    if command -v python3 >/dev/null 2>&1 && python3 -c "import gi" >/dev/null 2>&1; then
        python3 - << 'PYEOF'
import os, subprocess, tempfile, gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

rows = []
xml = """<node><interface name="org.startworkspace.WinProbe">
  <method name="Report">
    <arg type="s" name="cls" direction="in"/>
    <arg type="s" name="name" direction="in"/>
    <arg type="s" name="desktops" direction="in"/>
    <arg type="s" name="caption" direction="in"/>
  </method>
  <method name="Done"/>
</interface></node>"""

loop = GLib.MainLoop()
node = Gio.DBusNodeInfo.new_for_xml(xml)
tmp_path = None
script_name = f"winprobe_{os.getpid()}"

def on_call(conn, sender, path, iface, method, params, inv):
    if method == "Report":
        rows.append(params.unpack())
        inv.return_value(None)
    elif method == "Done":
        inv.return_value(None)
        loop.quit()

def on_acquired(conn, name):
    global tmp_path
    conn.register_object("/Probe", node.interfaces[0], on_call, None, None)
    js = f"""
var clients = workspace.windowList();
for (var i = 0; i < clients.length; i++) {{
    var c = clients[i];
    if (!c.normalWindow) continue;
    var dList = [];
    for (var j = 0; j < c.desktops.length; j++) {{
        dList.push(workspace.desktops.indexOf(c.desktops[j]) + 1);
    }}
    callDBus("org.startworkspace.WinProbe", "/Probe", "org.startworkspace.WinProbe", "Report",
        String(c.resourceClass || ""), String(c.resourceName || ""),
        dList.length ? dList.join(",") : "all", String(c.caption || ""));
}}
callDBus("org.startworkspace.WinProbe", "/Probe", "org.startworkspace.WinProbe", "Done");
"""
    with tempfile.NamedTemporaryFile("w", suffix=".js", delete=False) as f:
        f.write(js)
        tmp_path = f.name
    subprocess.run(["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.loadScript", tmp_path, script_name],
                   check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.start"],
                   check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    GLib.timeout_add(1500, loop.quit)

try:
    Gio.bus_own_name(Gio.BusType.SESSION, "org.startworkspace.WinProbe", Gio.BusNameOwnerFlags.NONE, on_acquired, None, None)
    loop.run()
finally:
    subprocess.run(["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.unloadScript", script_name],
                   check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if tmp_path and os.path.exists(tmp_path):
        os.unlink(tmp_path)

if not rows:
    print("No open normal windows detected (or KWin Scripting D-Bus is unavailable).")
else:
    print(f"\n{'Desktop':<8} {'resourceClass':<28} {'resourceName':<24} {'Window Title'}")
    print("-" * 100)
    for cls, name, desks, caption in rows:
        print(f"{desks:<8} {cls[:28]:<28} {(name or '-')[:24]:<24} {caption[:45]}")
    print()
PYEOF
    else
        warn "python3 with PyGObject (gi) not found; falling back to click-to-inspect mode."
        info "Click any open window to inspect its KWin resourceClass & resourceName..."
        qdbus6 org.kde.KWin /KWin org.kde.KWin.queryWindowInfo
    fi
}

cmd_gui() {
    local gui_bin="$SCRIPT_DIR/setup-workspace-gui"
    if [ ! -f "$gui_bin" ]; then
        err "GUI script not found: $gui_bin"
        return 1
    fi
    if ! command -v python3 >/dev/null 2>&1 || ! python3 -c "import PyQt6.QtWidgets" >/dev/null 2>&1; then
        err "PyQt6 is required for the GUI (install with: sudo pacman -S python-pyqt6)."
        return 1
    fi
    chmod +x "$gui_bin"
    exec "$gui_bin" "$@"
}

cmd_install() {
    mkdir -p "$BIN_DIR" "$APPS_DIR"
    for s in "${MANAGED_SCRIPTS[@]}"; do
        local src="$SCRIPT_DIR/$s"
        local dst="$BIN_DIR/$s"
        if [ ! -f "$src" ]; then
            err "Missing script: $src"
            return 1
        fi
        chmod +x "$src"
        ln -sf "$src" "$dst"
        success "Linked $dst -> $src"
    done

    cat > "$DESKTOP_LAUNCHER" << EOF
[Desktop Entry]
Type=Application
Name=Workspace Setup
Comment=Configure workspace applications across KDE Virtual Desktops
Exec=$BIN_DIR/setup-workspace-gui
Icon=preferences-desktop-display
Terminal=false
Categories=Settings;System;Qt;KDE;
EOF
    success "Created Application Launcher shortcut: $DESKTOP_LAUNCHER"

    case ":$PATH:" in
        *":$BIN_DIR:"*)
            success "$BIN_DIR is already in your \$PATH."
            ;;
        *)
            warn "$BIN_DIR is NOT in your \$PATH."
            echo "    Add this line to ~/.bashrc or ~/.zshrc:"
            echo "    export PATH=\"\$HOME/.local/bin:\$PATH\""
            ;;
    esac
}

cmd_uninstall() {
    local removed=0
    for s in "${MANAGED_SCRIPTS[@]}"; do
        local dst="$BIN_DIR/$s"
        if [ -L "$dst" ] || [ -f "$dst" ]; then
            rm -f "$dst"
            success "Removed $dst"
            removed=$((removed + 1))
        fi
    done
    if [ -f "$DESKTOP_LAUNCHER" ]; then
        rm -f "$DESKTOP_LAUNCHER"
        success "Removed $DESKTOP_LAUNCHER"
        removed=$((removed + 1))
    fi
    if [ "$removed" -eq 0 ]; then
        info "No installed symlinks or launcher entries found."
    fi
}

cmd_autostart() {
    local action="${1:-status}"
    local exec_path="$SCRIPT_DIR/start-workspace"
    [ -x "$BIN_DIR/start-workspace" ] && exec_path="$BIN_DIR/start-workspace"

    case "$action" in
        status)
            if [ -f "$AUTOSTART_FILE" ]; then
                success "Autostart is ENABLED ($AUTOSTART_FILE)"
            else
                info "Autostart is DISABLED ($AUTOSTART_FILE not present)"
            fi
            ;;
        enable)
            mkdir -p "$AUTOSTART_DIR"
            cat > "$AUTOSTART_FILE" << EOF
[Desktop Entry]
Type=Application
Name=Start Workspace
Comment=Launch configured workspace applications across Virtual Desktops
Exec=$exec_path
Icon=preferences-desktop-display
Terminal=false
X-KDE-autostart-phase=2
EOF
            success "Enabled login autostart at: $AUTOSTART_FILE"
            ;;
        disable)
            if [ -f "$AUTOSTART_FILE" ]; then
                rm -f "$AUTOSTART_FILE"
                success "Disabled login autostart (removed $AUTOSTART_FILE)"
            else
                info "Autostart was already disabled."
            fi
            ;;
        *)
            err "Unknown autostart action: $action (use: status, enable, disable)"
            return 1
            ;;
    esac
}

get_max_configured_desktop() {
    local max_d=1
    [ -f "$CONFIG_FILE" ] || { echo "3"; return; }
    load_config_lines
    for line in "${CONFIG_LINES[@]}"; do
        local desktop
        IFS='|' read -r desktop _ <<< "$line"
        if [[ "$desktop" =~ ^[0-9]+$ ]] && [ "$desktop" -gt "$max_d" ]; then
            max_d="$desktop"
        fi
    done
    echo "$max_d"
}

cmd_ensure_desktops() {
    if ! command -v qdbus6 >/dev/null 2>&1; then
        err "qdbus6 is not installed; cannot manage KDE Virtual Desktops."
        return 1
    fi

    local target_count
    target_count="$(get_max_configured_desktop)"
    local current_count
    current_count="$(qdbus6 org.kde.KWin /VirtualDesktopManager count 2>/dev/null || true)"

    if ! [[ "$current_count" =~ ^[0-9]+$ ]]; then
        err "Could not query KWin VirtualDesktopManager (is KDE Plasma running?)."
        return 1
    fi

    if [ "$current_count" -ge "$target_count" ]; then
        success "KDE Plasma already has $current_count Virtual Desktops (need $target_count)."
        return 0
    fi

    info "Creating Virtual Desktops ($current_count -> $target_count)..."
    local pos="$current_count"
    while [ "$pos" -lt "$target_count" ]; do
        local num=$((pos + 1))
        qdbus6 org.kde.KWin /VirtualDesktopManager createDesktop "$pos" "Desktop $num" >/dev/null 2>&1
        pos=$((pos + 1))
    done
    success "Virtual Desktop count is now $target_count."
}

cmd_doctor() {
    printf "\n${BOLD}Workspace Environment Check${RESET}\n\n"

    # 1. Core tools
    local required_tools=("bash" "pgrep" "pkill")
    for t in "${required_tools[@]}"; do
        if command -v "$t" >/dev/null 2>&1; then
            success "Tool available: $t"
        else
            err "Missing required tool: $t"
        fi
    done

    local optional_tools=("qdbus6" "notify-send" "flatpak")
    for t in "${optional_tools[@]}"; do
        if command -v "$t" >/dev/null 2>&1; then
            success "Optional tool available: $t"
        else
            warn "Optional tool not found: $t"
        fi
    done

    # 2. KDE Plasma / KWin D-Bus
    if command -v qdbus6 >/dev/null 2>&1; then
        local desktop_count
        desktop_count="$(qdbus6 org.kde.KWin /VirtualDesktopManager count 2>/dev/null || true)"
        if [[ "$desktop_count" =~ ^[0-9]+$ ]]; then
            local needed
            needed="$(get_max_configured_desktop)"
            if [ "$desktop_count" -ge "$needed" ]; then
                success "KDE KWin reachable: $desktop_count Virtual Desktops (need >= $needed)"
            else
                warn "KDE KWin has $desktop_count Virtual Desktops, but config uses Desktop $needed (run 'setup-workspace ensure-desktops')"
            fi
        else
            warn "KDE KWin D-Bus is not reachable (normal if not running inside a Plasma session)"
        fi
    fi

    # 3. CLI installation & PATH & Autostart
    local all_linked=true
    for s in "${MANAGED_SCRIPTS[@]}"; do
        if [ ! -x "$BIN_DIR/$s" ]; then
            all_linked=false
            break
        fi
    done
    if [ "$all_linked" = true ]; then
        success "CLI commands installed in $BIN_DIR"
    else
        warn "CLI commands not yet installed in $BIN_DIR (run 'setup-workspace install')"
    fi

    case ":$PATH:" in
        *":$BIN_DIR:"*) success "$BIN_DIR is in \$PATH" ;;
        *) warn "$BIN_DIR is not in \$PATH" ;;
    esac

    if [ -f "$AUTOSTART_FILE" ]; then
        success "Login autostart enabled ($AUTOSTART_FILE)"
    else
        info "Login autostart disabled (optional: 'setup-workspace autostart enable')"
    fi

    # 4. Config & configured app binaries
    if [ ! -f "$CONFIG_FILE" ]; then
        warn "No custom config at $CONFIG_FILE (using built-in defaults; run 'setup-workspace init' to customize)"
        echo ""
        return 0
    fi

    success "Config found: $CONFIG_FILE"
    load_config_lines
    echo ""
    printf "${BOLD}Configured Application Checks${RESET}\n"
    for line in "${CONFIG_LINES[@]}"; do
        local desktop name proc classes flags cmd
        IFS='|' read -r desktop name proc classes flags cmd <<< "$line"
        [[ ",$flags," == *",close_only,"* ]] || [ "$desktop" = "0" ] && continue

        local cmd_args=()
        if [ -n "$cmd" ]; then
            mapfile -t cmd_args < <(printf '%s\n' "$cmd" | xargs -n1 printf '%s\n' 2>/dev/null || true)
        fi
        local bin="${cmd_args[0]:-}"
        if [ -z "$bin" ]; then
            warn "$name: empty command"
            continue
        fi

        if [ -x "$bin" ] || command -v "$bin" >/dev/null 2>&1; then
            if [[ ",$flags," == *",check_arg1,"* ]] && [ -n "${cmd_args[1]:-}" ] && [ ! -e "${cmd_args[1]}" ]; then
                warn "$name: binary OK ($bin), optional file missing (${cmd_args[1]})"
            else
                success "$name: OK ($bin)"
            fi
        else
            warn "$name: executable not found ($bin)"
        fi
    done
    echo ""
}

cmd_reset() {
    local auto_yes=false
    local preset="auto"

    while [ "$#" -gt 0 ]; do
        case "$1" in
            -y|--yes) auto_yes=true; shift ;;
            --preset) preset="${2:-}"; shift 2 ;;
            *) err "Unknown option for reset: $1"; return 1 ;;
        esac
    done

    if [ "$auto_yes" = false ]; then
        local ans
        read -r -p "Overwrite $CONFIG_FILE with '$preset' preset? [y/N]: " ans
        if [[ ! "$ans" =~ ^[Yy]$ ]]; then
            info "Cancelled."
            return 0
        fi
    fi

    write_config_by_preset "$preset" || return 1
    success "Reset configuration ($preset) at: $CONFIG_FILE"
}

interactive_menu() {
    while true; do
        printf "\n${BOLD}=== Workspace Setup (Terminal Menu) ===${RESET}\n"
        printf "Config: ${DIM}%s${RESET}\n\n" "$CONFIG_FILE"
        echo "  1) Quick setup (auto-detect apps + install to ~/.local/bin + check system)"
        echo "  2) Open GUI Setup (PyQt6)"
        echo "  3) List configured workspace apps"
        echo "  4) Add a new app to workspace"
        echo "  5) Edit an existing app"
        echo "  6) Remove an app from workspace"
        echo "  7) Inspect open KWin windows (find resourceClass / resourceName)"
        echo "  8) Check dependencies & environment (doctor)"
        echo "  9) Ensure KDE Virtual Desktops match config"
        echo " 10) Toggle login autostart (enable / disable)"
        echo " 11) Install / Update CLI & App Menu (~/.local/bin)"
        echo " 12) Uninstall CLI & App Menu (~/.local/bin)"
        echo " 13) Reset configuration to defaults"
        echo " 14) Run start-workspace now"
        echo "  0) Exit"
        echo ""
        read -r -p "Choose an option [0-14]: " choice

        case "$choice" in
            1)
                cmd_init
                cmd_install
                cmd_doctor
                ;;
            2) cmd_gui ;;
            3) cmd_list ;;
            4) cmd_add ;;
            5) cmd_edit ;;
            6) cmd_remove ;;
            7) cmd_windows ;;
            8) cmd_doctor ;;
            9) cmd_ensure_desktops ;;
            10)
                if [ -f "$AUTOSTART_FILE" ]; then
                    cmd_autostart disable
                else
                    cmd_autostart enable
                fi
                ;;
            11) cmd_install ;;
            12) cmd_uninstall ;;
            13) cmd_reset ;;
            14) "$SCRIPT_DIR/start-workspace" ;;
            0|q|Q)
                info "Bye!"
                return 0
                ;;
            *)
                warn "Invalid option: $choice"
                ;;
        esac
    done
}

# --- Entrypoint ---
if [ "$#" -eq 0 ]; then
    interactive_menu
    exit $?
fi

subcmd="$1"
shift

case "$subcmd" in
    gui)             cmd_gui "$@" ;;
    init)            cmd_init "$@" ;;
    list)            cmd_list "$@" ;;
    add)             cmd_add "$@" ;;
    edit)            cmd_edit "$@" ;;
    remove|rm)       cmd_remove "$@" ;;
    windows|win)     cmd_windows "$@" ;;
    install)         cmd_install "$@" ;;
    uninstall)       cmd_uninstall "$@" ;;
    autostart)       cmd_autostart "$@" ;;
    doctor|check)    cmd_doctor "$@" ;;
    ensure-desktops) cmd_ensure_desktops "$@" ;;
    reset)           cmd_reset "$@" ;;
    path)            echo "$CONFIG_FILE" ;;
    -h|--help|help)  print_help ;;
    *)
        err "Unknown command: $subcmd"
        echo "Run 'setup-workspace --help' for usage."
        exit 1
        ;;
esac
