#!/usr/bin/env bash
# ========================================================
# Interactive & CLI Setup for Workspace Manager
# ========================================================

set -u

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/start-workspace"
CONFIG_FILE="$CONFIG_DIR/workspace.conf"
BIN_DIR="${HOME}/.local/bin"
APPS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
DESKTOP_LAUNCHER="$APPS_DIR/start-workspace-setup.desktop"
AUTOSTART_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"
AUTOSTART_FILE="$AUTOSTART_DIR/start-workspace.desktop"

MANAGED_SCRIPTS=("start-workspace" "stop-workspace" "setup-workspace" "setup-workspace-gui")

# Colors (disabled automatically when not a TTY)
if [ -t 1 ]; then
    BOLD='\033[1m'
    DIM='\033[2m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    RED='\033[0;31m'
    CYAN='\033[0;36m'
    RESET='\033[0m'
else
    BOLD='' DIM='' GREEN='' YELLOW='' RED='' CYAN='' RESET=''
fi

info()    { printf "${CYAN}[*]${RESET} %s\n" "$*"; }
success() { printf "${GREEN}[✓]${RESET} %s\n" "$*"; }
warn()    { printf "${YELLOW}[!]${RESET} %s\n" "$*"; }
err()     { printf "${RED}[✗]${RESET} %s\n" "$*" >&2; }

print_help() {
    cat << 'EOF'
Usage: setup-workspace [COMMAND] [OPTIONS]

Configure and manage start-workspace / stop-workspace from the terminal.
Run without arguments to open the interactive terminal menu.

Commands:
  gui                    Launch the PyQt6 graphical setup window (setup-workspace-gui)
  init [--preset MODE] [--force]
                         Create workspace.conf (~/.config/start-workspace/workspace.conf)
                         Presets: auto (default, detects installed apps), minimal, personal
  list                   List all configured workspace applications
  add [OPTIONS]          Add a new application entry (prompts for missing fields)
  edit [INDEX] [OPTIONS] Edit an existing entry by its list number
  remove [INDEX]         Remove an application entry by its list number
  windows [--pick]       List open KWin windows with resourceClass/resourceName (--pick to click)
  install                Symlink scripts into ~/.local/bin & add KDE App Launcher entry
  uninstall              Remove script symlinks & App Launcher entry
  autostart [STATE]      Manage login autostart: status (default), enable, disable
  doctor                 Check dependencies, KWin D-Bus, Virtual Desktops, and app paths
  ensure-desktops        Create KDE Virtual Desktops to match the highest configured desktop
  reset [--preset MODE] [--yes]
                         Reset workspace.conf using a preset (default: auto)
  path                   Print the configuration file path
  -h, --help             Show this help message

Options for 'add' / 'edit':
  --desktop N            Virtual Desktop number (1, 2, 3, ... or 0 for close-only)
  --name NAME            Display name (e.g. "VS Code")
  --pattern PATTERN      Process pattern for pgrep/pkill (e.g. "code")
  --classes CLASSES      Comma-separated KWin resourceClass/resourceName values
  --cmd COMMAND          Launch command (quote paths with spaces if needed)
  --keep-open            Keep running on stop-workspace unless --all is passed
  --flatpak              Mark as Flatpak app (enables 'flatpak kill' on stop)
  --close-only           Only stop this app in stop-workspace (do not launch in start-workspace)
EOF
}

write_config_header() {
    mkdir -p "$CONFIG_DIR"
    cat > "$CONFIG_FILE" << 'EOF'
# Workspace Manager Configuration
# Format: DESKTOP|NAME|PROC_PATTERN|WINDOW_CLASSES|FLAGS|COMMAND
#   DESKTOP        : 1-based Virtual Desktop number (0 = close-only for stop-workspace)
#   NAME           : Human-readable application name
#   PROC_PATTERN   : Pattern used by pgrep -f / pkill -f
#   WINDOW_CLASSES : Comma-separated KWin resourceClass / resourceName values
#   FLAGS          : Comma-separated flags: keep_open, flatpak, check_cmd, check_arg1, close_only
#   COMMAND        : Shell command to launch the application
EOF
}

detect_terminal_entry() {
    if command -v ptyxis >/dev/null 2>&1; then
        echo "1|Ptyxis Terminal|ptyxis|org.gnome.Ptyxis,ptyxis|keep_open|ptyxis"
    elif command -v konsole >/dev/null 2>&1; then
        echo "1|Konsole|konsole|org.kde.konsole,konsole|keep_open|konsole"
    elif command -v kitty >/dev/null 2>&1; then
        echo "1|Kitty Terminal|kitty|kitty|keep_open|kitty"
    elif command -v alacritty >/dev/null 2>&1; then
        echo "1|Alacritty|alacritty|Alacritty,alacritty|keep_open|alacritty"
    elif command -v ghostty >/dev/null 2>&1; then
        echo "1|Ghostty|ghostty|com.mitchellh.ghostty,ghostty|keep_open|ghostty"
    elif command -v gnome-terminal >/dev/null 2>&1; then
        echo "1|GNOME Terminal|gnome-terminal|org.gnome.Terminal,gnome-terminal-server|keep_open|gnome-terminal"
    fi
}

detect_file_manager_entry() {
    if command -v nautilus >/dev/null 2>&1; then
        echo "1|Files (Nautilus)|nautilus|org.gnome.Nautilus,nautilus||nautilus"
    elif command -v dolphin >/dev/null 2>&1; then
        echo "1|Files (Dolphin)|dolphin|org.kde.dolphin,dolphin||dolphin"
    elif command -v thunar >/dev/null 2>&1; then
        echo "1|Files (Thunar)|thunar|Thunar,thunar||thunar"
    fi
}

detect_browser_entry() {
    if command -v chromium >/dev/null 2>&1; then
        echo "2|Chromium Browser|chromium|chromium,Chromium,chromium-browser||chromium"
    elif command -v firefox >/dev/null 2>&1; then
        echo "2|Firefox|firefox|firefox,org.mozilla.firefox||firefox"
    elif command -v brave >/dev/null 2>&1; then
        echo "2|Brave Browser|brave|brave-browser||brave"
    elif command -v google-chrome >/dev/null 2>&1; then
        echo "2|Google Chrome|chrome|google-chrome||google-chrome"
    elif command -v zen-browser >/dev/null 2>&1; then
        echo "2|Zen Browser|zen-browser|zen,zen-alpha||zen-browser"
    fi
}

