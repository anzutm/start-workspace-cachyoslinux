write_minimal_config() {
    write_config_header
    local term_entry fm_entry browser_entry
    term_entry="$(detect_terminal_entry)"
    fm_entry="$(detect_file_manager_entry)"
    browser_entry="$(detect_browser_entry)"

    {
        echo ""
        echo "# --- Desktop 1 (Work) ---"
        [ -n "$term_entry" ] && echo "$term_entry"
        [ -n "$fm_entry" ] && echo "$fm_entry"
        echo ""
        echo "# --- Desktop 2 (Web) ---"
        [ -n "$browser_entry" ] && echo "$browser_entry"
    } >> "$CONFIG_FILE"
}

